			.join('');

		servicesContainer.innerHTML = tabsFilterHtml + cardsHtml;

		// Attach Listeners: Tab 3 Category Filter Buttons
		servicesContainer.querySelectorAll<HTMLButtonElement>('[data-exec-cat]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const cat = btn.dataset.execCat || 'all';
				servicesContainer.querySelectorAll('[data-exec-cat]').forEach((b) => b.classList.remove('is-active'));
