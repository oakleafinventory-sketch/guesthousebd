		// Helper to open scheduler modal for a stay with a pre-selected category
		function openSchedulerForStay(id: string, initialCategory = 'transport') {
			activeBookingId = id;
			const b = bookings.find((item) => item.id === id);
			if (!b) return;

			const stayTitle = document.getElementById('modal-sched-stay');
			if (stayTitle) stayTitle.textContent = `${b.stayName} (${b.checkIn} – ${b.checkOut})`;

			const dateSelect = document.getElementById('sched-date-select') as HTMLSelectElement | null;
			if (dateSelect) {
				dateSelect.innerHTML = '';
				const start = new Date(`${b.checkIn}T00:00:00`);
				const end = new Date(`${b.checkOut}T00:00:00`);
				const cur = new Date(start);
				while (cur <= end) {
					const dateStr = cur.toISOString().split('T')[0];
					const opt = document.createElement('option');
					opt.value = dateStr;
					opt.textContent = `${dateStr} (${cur.toLocaleDateString(getLocaleInfo().intl, { weekday: 'short', month: 'short', day: 'numeric' })})`;
					dateSelect.appendChild(opt);
					cur.setDate(cur.getDate() + 1);
				}
			}

			selectedCategory = initialCategory;
			document.querySelectorAll('#sched-category-filters .sched-nav-tab').forEach((cBtn) => {
				cBtn.classList.toggle('is-active', (cBtn as HTMLElement).dataset.cat === initialCategory);
			});

			const customContainer = document.getElementById('sched-custom-time-container');
			if (customContainer) customContainer.style.display = 'none';
			const slotSelect = document.getElementById('sched-slot-select') as HTMLSelectElement | null;
			if (slotSelect) slotSelect.value = 'morning';

			renderSchedulerProviders();
			checkLiveConflict();
			openModal('modal-schedule-service');
		}

		// Attach Listeners: Stay Services Tab Filtering
		bookingsContainer.querySelectorAll<HTMLButtonElement>('.stay-srv-tab-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const stayId = btn.dataset.stayId;
				const category = btn.dataset.category || 'all';
				if (!stayId) return;

				bookingsContainer.querySelectorAll(`.stay-srv-tab-btn[data-stay-id="${stayId}"]`).forEach((b) => {
					b.classList.remove('is-active');
				});
				btn.classList.add('is-active');

				const grid = document.getElementById(`services-grid-${stayId}`);
				const emptyBox = document.getElementById(`services-empty-cat-${stayId}`);
				const emptyTitle = document.getElementById(`empty-cat-title-${stayId}`);
				const emptyDesc = document.getElementById(`empty-cat-desc-${stayId}`);
				const emptyBtnText = document.getElementById(`empty-cat-btn-text-${stayId}`);
				const emptyBtn = document.getElementById(`btn-empty-book-${stayId}`) as HTMLButtonElement | null;
				if (!grid) return;

				const cards = grid.querySelectorAll<HTMLElement>('.service-item-card');
				let visibleCount = 0;

				cards.forEach((card) => {
					const cardCat = card.dataset.serviceCat || '';
					if (category === 'all' || cardCat === category) {
						card.style.display = 'flex';
						visibleCount++;
					} else {
						card.style.display = 'none';
					}
				});

				if (emptyBox) {
					if (visibleCount === 0) {
						emptyBox.style.display = 'flex';
						const catMeta: Record<string, { title: string; desc: string; label: string }> = {
							transport: {
								title: 'No Transport scheduled for this stay',
								desc: 'Book private airport pickup, executive chauffeur, or 4x4 SUV.',
								label: '+ Book Transport'
							},
							'travel-assistant': {
								title: 'No Travel Assistant scheduled for this stay',
								desc: 'Bilingual concierges for shopping, dining, and meetings.',
								label: '+ Book Travel Assistant'
							},
							'tour-guide': {
								title: 'No Tour Guide scheduled for this stay',
								desc: 'Certified local specialists for Old Dhaka heritage and cuisine walks.',
								label: '+ Book Tour Guide'
							},
							'extra-services': {
								title: 'No Extra services scheduled for this stay',
								desc: 'In-suite spa, personal chef, express laundry, or workstation.',
								label: '+ Book Extra services'
							}
						};

						const meta = catMeta[category] || {
							title: 'No services scheduled in this category',
							desc: 'Book a professional provider to assist during your stay.',
							label: '+ Book Service'
						};

						if (emptyTitle) emptyTitle.textContent = meta.title;
						if (emptyDesc) emptyDesc.textContent = meta.desc;
						if (emptyBtnText) emptyBtnText.textContent = meta.label;
						if (emptyBtn) {
							emptyBtn.onclick = () => {
								openSchedulerForStay(stayId, category === 'all' ? 'transport' : category);
							};
						}
					} else {
						emptyBox.style.display = 'none';
					}
				}
			});
		});

		// Attach Listeners: Open Multi-Service Scheduler
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-open-scheduler]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.openScheduler;
				if (!id) return;
				openSchedulerForStay(id, 'transport');
			});
		});

		// Attach Listeners: Remove Stay Service with 4-Hour Cancellation Guarantee
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-remove-stay-service]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.removeStayService;
				if (!raw) return;
				const [bookingId, serviceId] = raw.split(':');
				const b = authManager.getBookings().find((item) => item.id === bookingId);
				const s = (b?.services || []).find((item) => item.id === serviceId);
				if (!s) return;

				const policy = authManager.canCancelService(s);
				let confirmMsg = '';
				if (policy.canCancel) {
					confirmMsg = `Cancel scheduled service "${s.title}"?\n\n✓ Eligible for 100% full refund (more than 4 hours before scheduled service).\nFree cancellation until: ${policy.deadlineFormatted}.`;
				} else {
					confirmMsg = `⚠️ Notice: Cancellation within 4 hours\n\n${policy.reason}\n\nDo you still wish to cancel this scheduled service without a refund?`;
				}

				if (confirm(confirmMsg)) {
					const res = authManager.removeServiceFromStay(bookingId, serviceId);
					alert(res.message);
					renderBookings();
					renderServicesTab();
				}
			});
		});

		// Attach Listeners: Open Service Payment Modal
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-open-payment]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.openPayment;
				if (!raw) return;
				const [bookingId, serviceId, priceStr, titleEnc, providerNameEnc, avatarEnc, catNameEnc] = raw.split(':');
				const title = decodeURIComponent(titleEnc || '');
				const providerName = decodeURIComponent(providerNameEnc || '');
				const avatar = decodeURIComponent(avatarEnc || '');
				const catName = decodeURIComponent(catNameEnc || '');
				const price = parseFloat(priceStr) || 0;

				activePaymentData = { bookingId, serviceId, price, title, providerName };

				const titleEl = document.getElementById('pay-service-title');
				const nameEl = document.getElementById('pay-provider-name');
				const avatarEl = document.getElementById('pay-provider-avatar') as HTMLImageElement | null;
				const catEl = document.getElementById('pay-service-category');
				const amountEl = document.getElementById('pay-amount-display');

				if (titleEl) titleEl.textContent = title;
				if (nameEl) nameEl.textContent = `Proposed to ${providerName}`;
				if (avatarEl && avatar) avatarEl.src = avatar;
				if (catEl) catEl.textContent = catName;
				if (amountEl) amountEl.textContent = `$${price} USD`;

				openModal('modal-service-payment');
			});
		});

		// Attach Listeners: Toggle Provider Acknowledgment Flag (Demo Simulation)
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-ack-service]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.ackService;
				if (!raw) return;
				const [bookingId, serviceId] = raw.split(':');
				authManager.toggleServiceAcknowledgment(bookingId, serviceId);
				renderBookings();
				renderServicesTab();
			});
		});

		// Attach Listeners: Location Modal
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-open-location]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.openLocation;
				const b = bookings.find((item) => item.id === id);
				if (!b) return;

				const eyebrow = document.getElementById('modal-loc-eyebrow');
				const addressEl = document.getElementById('modal-loc-address');
				const codeEl = document.getElementById('modal-loc-code');
				const mapLink = document.getElementById('link-google-maps') as HTMLAnchorElement | null;
				const directionsBtn = document.getElementById('btn-modal-directions') as HTMLAnchorElement | null;

				const fullAddress = b.address || `House 24, Road 113, ${b.area}, ${b.city} 1212, Bangladesh`;
				const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.stayName + ' ' + b.area + ' ' + b.city + ' Bangladesh')}`;

				if (eyebrow) eyebrow.textContent = `${b.city.toUpperCase()} · ${b.area.toUpperCase()}`;
				if (addressEl) addressEl.textContent = fullAddress;
				if (codeEl) codeEl.textContent = b.confirmationCode;
				if (mapLink) mapLink.href = mapsUrl;
				if (directionsBtn) directionsBtn.href = mapsUrl;

				openModal('modal-location');
			});
		});

		// Attach Listeners: Host Modal
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-open-host]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.openHost;
				const b = bookings.find((item) => item.id === id);
				if (!b) return;

				const stayEl = document.getElementById('modal-host-stay');
				const nameEl = document.getElementById('modal-host-name');
				const avatarEl = document.getElementById('modal-host-avatar') as HTMLImageElement | null;
				const phoneEl = document.getElementById('modal-host-phone-display');
				const telBtn = document.getElementById('modal-host-tel-btn') as HTMLAnchorElement | null;
				const waBtn = document.getElementById('modal-host-wa-btn') as HTMLAnchorElement | null;
				const feedback = document.getElementById('host-msg-sent-feedback');

				const hostName = b.hostName || 'Farhana Yasmin';
				const hostAvatar = b.hostAvatar || 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=200&auto=format&fit=crop&q=80';
				const hostPhone = b.hostPhone || '+880 1711 234567';
				const cleanPhone = hostPhone.replace(/\s+/g, '');
				const digits = hostPhone.replace(/[^0-9]/g, '');

				if (stayEl) stayEl.textContent = b.stayName;
				if (nameEl) nameEl.textContent = hostName;
				if (avatarEl) {
					avatarEl.src = hostAvatar;
					avatarEl.alt = hostName;
				}
				if (phoneEl) phoneEl.textContent = hostPhone;
				if (telBtn) telBtn.href = `tel:${cleanPhone}`;
				if (waBtn) waBtn.href = `https://wa.me/${digits}`;
				if (feedback) feedback.hidden = true;

				openModal('modal-host');
			});
		});

		// Attach cancel listeners
		bookingsContainer.querySelectorAll<HTMLButtonElement>('[data-cancel-booking]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.cancelBooking;
				if (id && confirm('Cancel this reservation? Full refund applies for member cancellations.')) {
					authManager.cancelBooking(id);
					renderBookings();
					renderServicesTab();
				}
			});
		});
	}

	// ---------------- Scheduler Modal Logic & Conflict Validation ---------------- //
	function renderSchedulerProviders() {
		const list = document.getElementById('sched-provider-list');
		if (!list) return;

		const filtered = servicesData.providers.filter((p) => p.categoryId === selectedCategory);
		const displayList = filtered.length > 0 ? filtered : servicesData.providers;

		if (!displayList.some((p) => p.id === selectedProviderId)) {
			selectedProviderId = displayList[0]?.id || '';
		}

		list.innerHTML = displayList
			.map(
				(p) => `
			<div class="sched-provider-showcase-card ${p.id === selectedProviderId ? 'is-selected' : ''}" data-provider-id="${p.id}">
				<!-- Left: Portrait Image (Matches Sketch) -->
				<div class="sched-provider-portrait-wrap">
					<img src="${p.photo}" alt="${p.name}" class="sched-provider-portrait-img" />
				</div>

				<!-- Center: Details Information (Matches Sketch) -->
				<div class="sched-provider-details-col">
					<div class="sched-provider-name-row">
						<span class="sched-provider-title-name">${p.name}</span>
						<span class="sched-provider-rating-pill">★ ${p.rating} <span style="color:var(--dash-muted); font-size:10px;">(${p.reviewsCount} reviews)</span></span>
					</div>
					<div class="sched-provider-role-badge">${p.badge} · ${p.languages.join(', ')}</div>
					<div class="sched-provider-service-desc"><strong>${p.title}</strong> — ${p.description}</div>
					${
						(p.subServices || []).length > 0
							? `
					<div class="sched-provider-subtags">
						${(p.subServices || []).map((sub: string) => `<span class="sched-subtag">✦ ${sub}</span>`).join('')}
					</div>
					`
							: ''
					}
				</div>

				<!-- Right: Available Badge & CTA: PICK ME (Matches Sketch) -->
				<div class="sched-provider-right-col">
					<div class="sched-avail-badge">
						<span>Available</span>
						<span class="sched-avail-check-box">✓</span>
					</div>
					<div class="sched-provider-price-tag">
						$${p.basePrice} <small>/ service</small>
					</div>
					<button type="button" class="btn-pick-provider ${p.id === selectedProviderId ? 'is-active' : ''}" data-pick-id="${p.id}">
						${p.id === selectedProviderId ? '✓ Selected' : 'Pick Me'}
					</button>
				</div>
			</div>
		`
			)
			.join('');

		list.querySelectorAll<HTMLElement>('[data-provider-id]').forEach((card) => {
			const providerId = card.dataset.providerId || '';
			const pickBtn = card.querySelector<HTMLButtonElement>('.btn-pick-provider');

			const selectHandler = (e: Event) => {
				e.stopPropagation();
				selectedProviderId = providerId;
				list.querySelectorAll('.sched-provider-showcase-card').forEach((el) => {
					const isTarget = (el as HTMLElement).dataset.providerId === selectedProviderId;
					el.classList.toggle('is-selected', isTarget);
					const btn = el.querySelector<HTMLButtonElement>('.btn-pick-provider');
					if (btn) {
						btn.classList.toggle('is-active', isTarget);
						btn.textContent = isTarget ? '✓ Selected' : 'Pick Me';
					}
				});
				updateSchedulerPrice();
				checkLiveConflict();
			};

			card.addEventListener('click', selectHandler);
			if (pickBtn) pickBtn.addEventListener('click', selectHandler);
		});

		updateSchedulerPrice();
	}

	function updateSchedulerPrice() {
		const provider = servicesData.providers.find((p) => p.id === selectedProviderId);
		const summary = document.getElementById('sched-price-summary');
		if (!provider || !summary) return;

		const user = authManager.getUser();
		const perk = authManager.getMemberDiscount(provider.basePrice);
		summary.innerHTML = `Rate: <strong>$${perk.discountedTotal} USD</strong> <span style="color:var(--dash-emerald); font-size:11.5px; font-weight:600;">(${perk.percentage}% VIP Applied)</span> <del style="color:var(--dash-muted); font-size:11px; margin-left:4px;">$${provider.basePrice}</del>`;
	}

	function checkLiveConflict() {
		if (!activeBookingId) return;
		const booking = authManager.getBookings().find((b) => b.id === activeBookingId);
		if (!booking) return;

		const provider = servicesData.providers.find((p) => p.id === selectedProviderId);
		const dateSelect = document.getElementById('sched-date-select') as HTMLSelectElement | null;
		const slotSelect = document.getElementById('sched-slot-select') as HTMLSelectElement | null;
		const customTimeInput = document.getElementById('sched-custom-time') as HTMLInputElement | null;
		const conflictBanner = document.getElementById('sched-conflict-banner');
		const conflictText = document.getElementById('sched-conflict-text');
		const availableBanner = document.getElementById('sched-available-banner');
		const availableText = document.getElementById('sched-available-text');
		const confirmBtn = document.getElementById('btn-confirm-scheduled-service') as HTMLButtonElement | null;

		const date = dateSelect?.value || '';
		const slotId = slotSelect?.value || 'morning';
		const customTime = slotId === 'custom' ? (customTimeInput?.value || '10:30') : undefined;

		const conflict = authManager.checkServiceConflict(
			booking.services || [],
			date,
			slotId,
			selectedProviderId,
			customTime
		);

		if (conflict.hasConflict) {
			if (conflictBanner) conflictBanner.style.display = 'flex';
			if (conflictText) conflictText.textContent = conflict.message || 'Schedule Collision on this date/time!';
			if (availableBanner) availableBanner.style.display = 'none';
			if (confirmBtn) {
				confirmBtn.disabled = true;
				confirmBtn.style.opacity = '0.5';
				confirmBtn.style.cursor = 'not-allowed';
			}
		} else {
			if (conflictBanner) conflictBanner.style.display = 'none';
			if (availableBanner) availableBanner.style.display = 'flex';
			if (availableText) {
				const timeDisplay = slotId === 'custom' ? `Custom Time: ${customTime}` : slotSelect?.options[slotSelect.selectedIndex]?.textContent || 'Morning';
				availableText.textContent = `✓ ${provider ? provider.name : 'Provider'} is available on ${date} (${timeDisplay})!`;
			}
			if (confirmBtn) {
				confirmBtn.disabled = false;
				confirmBtn.style.opacity = '1';
				confirmBtn.style.cursor = 'pointer';
			}
		}
	}

	// Category tab clicks matching sketch (Transport, Travel Assistant, Tour Guide, Extra services)
	document.querySelectorAll('#sched-category-filters .sched-nav-tab').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('#sched-category-filters .sched-nav-tab').forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			selectedCategory = (btn as HTMLElement).dataset.cat || 'transport';
			renderSchedulerProviders();
			checkLiveConflict();
		});
	});

	// Date & Slot change listeners
	document.getElementById('sched-date-select')?.addEventListener('change', checkLiveConflict);
	
	const slotSelectEl = document.getElementById('sched-slot-select') as HTMLSelectElement | null;
	const customTimeContainer = document.getElementById('sched-custom-time-container');
	slotSelectEl?.addEventListener('change', () => {
		if (slotSelectEl.value === 'custom') {
			if (customTimeContainer) customTimeContainer.style.display = 'block';
		} else {
			if (customTimeContainer) customTimeContainer.style.display = 'none';
		}
		checkLiveConflict();
	});

	document.getElementById('sched-custom-time')?.addEventListener('change', checkLiveConflict);

	// Biometric Fingerprint State & Handlers
	let pendingBiometricAction: (() => void) | null = null;

	function resetBiometricModal(serviceName: string) {
		const target = document.getElementById('bio-service-target');
		const prompt = document.getElementById('bio-prompt-text');
		const statusText = document.getElementById('bio-status-text');
		const statusDot = document.getElementById('bio-status-dot');
		const card = document.getElementById('bio-scanner-card');
		if (target) target.textContent = `Authorizing: ${serviceName}`;
		if (prompt) prompt.textContent = 'Touch your fingerprint sensor (Touch ID / Windows Hello) or tap the scanner above to verify your identity.';
		if (statusText) statusText.textContent = 'Sensor Waiting for Fingerprint...';
		if (statusDot) statusDot.style.background = 'var(--dash-brand)';
		if (card) {
			card.style.borderColor = 'var(--dash-brand)';
			card.style.background = 'var(--dash-surface-soft)';
		}
	}

	function performBiometricVerification() {
		const statusText = document.getElementById('bio-status-text');
		const statusDot = document.getElementById('bio-status-dot');
		const card = document.getElementById('bio-scanner-card');
		if (statusText) statusText.textContent = 'Scanning Biometric Sensor...';
		if (statusDot) statusDot.style.background = '#f59e0b';
		if (card) card.style.borderColor = '#f59e0b';

		setTimeout(() => {
			if (statusText) statusText.textContent = 'Fingerprint Verified ✓';
			if (statusDot) statusDot.style.background = '#10b981';
			if (card) {
				card.style.borderColor = '#10b981';
				card.style.background = 'rgba(16, 185, 129, 0.08)';
			}
			setTimeout(() => {
				closeModal('modal-biometric-auth');
				if (pendingBiometricAction) {
					const action = pendingBiometricAction;
					pendingBiometricAction = null;
					action();
				}
			}, 600);
		}, 800);
	}

	document.getElementById('bio-scanner-card')?.addEventListener('click', performBiometricVerification);
	document.getElementById('btn-trigger-bio-scan')?.addEventListener('click', performBiometricVerification);

	// Confirm Scheduled Service Button (with Biometric Gate & 4-Hour Cancellation Guarantee)
	document.getElementById('btn-confirm-scheduled-service')?.addEventListener('click', () => {
		if (!activeBookingId) return;
		const provider = servicesData.providers.find((p) => p.id === selectedProviderId);
		if (!provider) return;

		const dateSelect = document.getElementById('sched-date-select') as HTMLSelectElement | null;
		const slotSelect = document.getElementById('sched-slot-select') as HTMLSelectElement | null;
		const customTimeInput = document.getElementById('sched-custom-time') as HTMLInputElement | null;
		const date = dateSelect?.value || '';
		const slotId = slotSelect?.value || 'morning';
		let slotLabel = slotSelect?.options[slotSelect.selectedIndex]?.textContent || 'Morning (09:00 – 13:00)';
		if (slotId === 'custom') {
			slotLabel = `Custom Time: ${customTimeInput?.value || '10:30'}`;
		}

		const category = servicesData.categories.find((c) => c.id === provider.categoryId);
		const perk = authManager.getMemberDiscount(provider.basePrice);

		const payChoiceEl = document.querySelector('input[name="sched-pay-choice"]:checked') as HTMLInputElement | null;
		const payChoice = payChoiceEl?.value || 'now';
		const paymentStatus: 'paid' | 'unpaid' = payChoice === 'now' ? 'paid' : 'unpaid';

		const executeDispatch = () => {
			const result = authManager.addServiceToStay(activeBookingId!, {
				providerId: provider.id,
				categoryId: provider.categoryId as any,
				categoryName: category?.name || 'Personal Assistant',
				title: provider.title,
				subServiceTitle: (provider.subServices && provider.subServices[0]) || provider.title,
				providerName: provider.name,
				providerPhone: provider.phone,
				providerAvatar: provider.photo,
				date,
				timeSlotId: slotId,
				timeSlotLabel: slotLabel,
				price: perk.discountedTotal,
				currency: 'USD',
				paymentStatus,
				acknowledgedByProvider: false
			});

			if (result.success) {
				alert(`✓ Booking Transmitted & Dispatched!\n\nReference: ${result.service?.id}\nGuesthouseBD dispatch and ${provider.name} have been notified via Push Notification, Email & SMS.\n\n🛡️ Admin Policy: Free cancellation with 100% full refund available up to 4 hours before service time.`);
				closeModal('modal-schedule-service');
				renderBookings();
				renderServicesTab();
			} else {
				alert(result.error || 'Cannot schedule service due to conflict.');
			}
		};

		// Enforce fingerprint auth ONLY for tour assistant and guide bookings if enabled in traveler profile
		const currentUser = authManager.getUser();
		const isGuidedService = provider.categoryId === 'tour-guide' || provider.categoryId === 'tour-assistant';

		if (isGuidedService && currentUser?.fingerprintEnabled) {
			pendingBiometricAction = executeDispatch;
			resetBiometricModal(`${provider.name} (${category?.name || 'Tour Guide'})`);
			openModal('modal-biometric-auth');
			return;
		}

		executeDispatch();
	});

	// Authorize & Submit Service Payment
	document.getElementById('btn-submit-service-payment')?.addEventListener('click', () => {
		if (!activePaymentData) return;
		authManager.markServicePaid(activePaymentData.bookingId, activePaymentData.serviceId);
		closeModal('modal-service-payment');
		renderBookings();
		renderServicesTab();
	});

	// Copy Address in Location Modal
	const copyAddressBtn = document.getElementById('btn-copy-address');
	const copyTextSpan = document.getElementById('copy-btn-text');
	copyAddressBtn?.addEventListener('click', async () => {
		const address = document.getElementById('modal-loc-address')?.textContent || '';
		try {
			await navigator.clipboard.writeText(address);
			if (copyTextSpan) copyTextSpan.textContent = t('locModal.addressCopied');
			copyAddressBtn.classList.add('is-copied');
			setTimeout(() => {
				if (copyTextSpan) copyTextSpan.textContent = t('locModal.copyAddress');
				copyAddressBtn.classList.remove('is-copied');
			}, 2000);
		} catch {
			if (copyTextSpan) copyTextSpan.textContent = t('locModal.addressCopied');
		}
	});

	// Send Host Quick Message
	const sendHostMsgBtn = document.getElementById('btn-send-host-msg');
	const hostMsgInput = document.getElementById('host-quick-msg') as HTMLInputElement | null;
	const hostFeedback = document.getElementById('host-msg-sent-feedback');
	sendHostMsgBtn?.addEventListener('click', () => {
		if (hostMsgInput && hostMsgInput.value.trim().length > 0) {
			if (hostFeedback) hostFeedback.hidden = false;
			hostMsgInput.value = '';
			setTimeout(() => {
				if (hostFeedback) hostFeedback.hidden = true;
			}, 3000);
		}
	});

	function renderSavedStays() {
		const saved = authManager.getSavedStays();
		if (statSaved) statSaved.textContent = String(saved.length);
		if (tabBadgeSaved) tabBadgeSaved.textContent = String(saved.length);

		if (!savedContainer) return;

		if (saved.length === 0) {
			savedContainer.innerHTML = '';
			if (savedEmpty) savedEmpty.hidden = false;
			return;
		}

		if (savedEmpty) savedEmpty.hidden = true;

		savedContainer.innerHTML = saved
			.map(
				(s) => `
			<article class="saved-card">
				<div class="saved-image-wrap">
					<img src="${s.image}" alt="${s.name}" loading="lazy" />
					<button type="button" class="saved-heart-btn" data-remove-saved="${s.slug}" aria-label="Remove from saved">♥</button>
					<span class="saved-rating-tag">★ ${s.rating.toFixed(1)} (${s.reviewCount})</span>
				</div>
				<div class="saved-body">
					<div>
						<span class="saved-area">${s.area}, ${s.city}</span>
						<h4 class="saved-title">${s.name}</h4>
					</div>
					<div class="saved-footer">
						<span class="saved-price"><strong>$${s.price}</strong> <small>/ night</small></span>
						<a href="/guestHouses/${s.city.toLowerCase()}/${s.slug}/" class="btn-view-stay" style="height:32px; padding:0 12px; font-size:11px;">${t('dashboard.viewProperty')} ↗</a>
					</div>
				</div>
			</article>
		`
			)
			.join('');

		// Attach remove listeners
		savedContainer.querySelectorAll<HTMLButtonElement>('[data-remove-saved]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const slug = btn.dataset.removeSaved;
				if (slug) {
