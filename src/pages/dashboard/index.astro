	// ---------------- Executive Guides & Transport Services Tab ---------------- //
	function renderServicesTab() {
		const bookings = authManager.getBookings();
		const servicesContainer = document.getElementById('services-tab-container');
		const servicesEmpty = document.getElementById('services-tab-empty');
		const statGuides = document.getElementById('stat-guides');
		const tabBadgeServices = document.getElementById('tab-badge-services');

		interface FlattenedService extends StayBookedService {
			booking: BookingRecord;
		}

		const allServices: FlattenedService[] = [];
		bookings.forEach((b) => {
			if (b.status !== 'cancelled' && b.services) {
				b.services.forEach((s) => {
					allServices.push({ ...s, booking: b });
				});
			}
		});

		if (statGuides) statGuides.textContent = String(allServices.length);
		if (tabBadgeServices) tabBadgeServices.textContent = String(allServices.length);

		if (!servicesContainer) return;

		if (allServices.length === 0) {
			servicesContainer.innerHTML = '';
			if (servicesEmpty) servicesEmpty.hidden = false;
			return;
		}

		if (servicesEmpty) servicesEmpty.hidden = true;

		const execTransportCount = allServices.filter(s => s.categoryId === 'transport').length;
		const execAssistantCount = allServices.filter(s => s.categoryId === 'travel-assistant' || s.categoryId === 'tour-assistant').length;
		const execGuideCount = allServices.filter(s => s.categoryId === 'tour-guide').length;
		const execExtraCount = allServices.filter(s => s.categoryId === 'extra-services' || s.categoryId === 'amenities').length;

