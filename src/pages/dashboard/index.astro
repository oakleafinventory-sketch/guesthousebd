---
import PageLayout from '../../layouts/PageLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AuthModal from '../../components/AuthModal.astro';
import '../../styles/dashboard.css';
---

<PageLayout title="My Dashboard — GuesthouseBD" description="Manage your bookings, saved wishlists, and member discounts." includeSiteScript={false}>
	<div class="dashboard-page" id="dashboard-root">
		<!-- Top Dashboard Navigation Bar -->
		<header class="dash-topbar">
			<div class="dash-topbar-inner">
				<a href="/" class="dash-brand" aria-label="GuesthouseBD Home">
					<img src="/assets/logo/logo.png" data-theme-logo-light="/assets/logo/logo.png" data-theme-logo-dark="/assets/logo/logo-darkmode.png" alt="GuesthouseBD" />
				</a>

				<nav class="dash-nav-links" aria-label="Quick links">
					<a href="/" class="dash-link"><span>🌍</span> <span data-i18n="nav.all">Explore All</span></a>
					<a href="/guestHouses/dhaka/" class="dash-link"><span>⌂</span> <span data-i18n="nav.stays">Dhaka Stays</span></a>
					<a href="/#ride" class="dash-link"><span>↗</span> <span data-i18n="nav.ride">Pick &amp; drop</span></a>
					<a href="/#people" class="dash-link"><span>✦</span> <span data-i18n="nav.guides">Guides</span></a>
				</nav>

				<div class="dash-user-controls">
					<button class="theme-toggle-btn" type="button" data-dashboard-theme-toggle aria-label="Switch theme">
						<span data-dashboard-theme-icon>☾</span>
					</button>
					<button type="button" class="dash-logout-btn" id="dash-logout">
						<span>🚪</span>
						<span data-i18n="nav.signOut">Sign Out</span>
					</button>
				</div>
			</div>
		</header>

		<!-- Unauthenticated Gatekeeper Screen -->
		<section class="dash-unauth-screen" id="dash-unauth" hidden style="display:flex; justify-content:center; align-items:center; min-height:65vh; padding:32px 16px;">
			<div class="dash-empty-card" style="max-width: 460px; width:100%; padding: 42px 28px;">
				<span class="dash-empty-icon">🔒</span>
				<h1 style="font-size:22px; font-weight:700; margin-bottom:8px;" data-i18n="dashboard.unauthTitle">Member Access Required</h1>
				<p style="margin-bottom:24px;" data-i18n="dashboard.unauthDesc">Sign in to your GuesthouseBD account to access your personal reservations, saved stays wishlist, and exclusive member discounts.</p>
				<div style="display:flex; flex-direction:column; gap:10px;">
					<button type="button" class="btn-primary-pill" data-open-auth="signin" style="justify-content:center;">
						<span data-i18n="dashboard.signInBtn">Sign In to Dashboard</span>
						<i>↗</i>
					</button>
					<a href="/" class="dash-link" style="justify-content:center;" data-i18n="dashboard.returnHome">Return to Homepage</a>
				</div>
			</div>
		</section>

		<!-- Authenticated Main Dashboard -->
		<main class="dash-main" id="dash-authenticated" hidden>
			<!-- Hero Profile Header Banner -->
			<section class="dash-hero-card">
				<div class="dash-profile-row">
					<div class="dash-profile-meta-wrap">
						<div class="dash-avatar-large">
							<img src="" alt="" id="user-avatar-large" />
							<span class="dash-status-dot"></span>
						</div>
						<div class="dash-profile-info">
							<div class="dash-profile-heading">
								<h1 id="user-display-title">Welcome back, Traveler</h1>
								<span class="dash-tier-badge" id="user-tier-badge">Gold VIP</span>
							</div>
							<p class="dash-user-meta">
								<span id="user-email-text">user@example.com</span>
								<span class="meta-dot">·</span>
								<span id="user-since-text">Member since March 2024</span>
							</p>
						</div>
					</div>

					<div class="dash-membership-card">
						<div class="member-perk-header">
							<span class="perk-star">✦</span>
							<strong data-i18n="dashboard.activeMemberPrivilege">Active Member Privilege</strong>
						</div>
						<p class="member-perk-desc" id="user-perk-summary">15% VIP Club Rate Applied Automatically</p>
						<small class="member-perk-note" data-i18n="dashboard.privilegeNote">Valid across all guesthouses, rides &amp; guide bookings</small>
					</div>
				</div>

				<!-- Stats Summary Grid -->
				<div class="dash-stats-grid">
					<div class="stat-box">
						<span class="stat-icon-bubble is-blue">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
						</span>
						<div>
							<strong class="stat-value" id="stat-bookings">0</strong>
							<span class="stat-label" data-i18n="dashboard.statBookings">Active Bookings</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon-bubble is-crimson">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
						</span>
						<div>
							<strong class="stat-value" id="stat-saved">0</strong>
							<span class="stat-label" data-i18n="dashboard.statSaved">Saved Stays</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon-bubble is-emerald">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="12" y1="16" x2="12" y2="18"/></svg>
						</span>
						<div>
							<strong class="stat-value" id="stat-saved-money">$120+</strong>
							<span class="stat-label" data-i18n="dashboard.statSavings">Member Savings</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon-bubble is-indigo">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 19 21 12 17 5 21 12 2"/></svg>
						</span>
						<div>
							<strong class="stat-value" id="stat-guides">1</strong>
							<span class="stat-label" data-i18n="dashboard.statGuides">Guides Hired</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Segmented Pill Tabs Bar -->
			<div class="dash-tabs-bar">
				<nav class="dash-tabs-pill" aria-label="Dashboard sections">
					<button type="button" class="dash-tab-btn is-active" data-tab-target="tab-bookings">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
						<span data-i18n="dashboard.tabReservations">My Reservations</span>
						<span class="tab-badge" id="tab-badge-bookings">0</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-saved">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
						<span data-i18n="dashboard.tabSaved">Saved Stays</span>
						<span class="tab-badge" id="tab-badge-saved">0</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-services">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 19 21 12 17 5 21 12 2"/></svg>
						<span data-i18n="dashboard.tabServices">Guides &amp; Rides</span>
						<span class="tab-badge" id="tab-badge-services">0</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-settings">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
						<span data-i18n="dashboard.tabSettings">Settings</span>
					</button>
				</nav>
			</div>

			<!-- TAB 1: My Reservations -->
			<section class="dash-panel-content" id="tab-bookings">
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.reservationsHeading">My Reservations</h2>
						<p data-i18n="dashboard.reservationsSub">Confirmed guesthouse stays, check-in instructions, and itinerary codes.</p>
					</div>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" style="height:36px; font-size:12px; padding:0 16px;">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
						<span data-i18n="dashboard.bookStay">Book Stay</span>
					</a>
				</div>

				<div class="bookings-list" id="bookings-container">
					<!-- Dynamically rendered via client script -->
				</div>

				<div class="dash-empty-card" id="bookings-empty" hidden>
					<span class="dash-empty-icon">
						<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>
					</span>
					<h3 data-i18n="dashboard.noReservationsTitle">No reservations found yet</h3>
					<p data-i18n="dashboard.noReservationsDesc">Explore verified guesthouses in Dhaka with member discounts applied automatically.</p>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" data-i18n="dashboard.browseStays">Browse Dhaka Guesthouses ↗</a>
				</div>
			</section>

			<!-- TAB 2: Saved Stays (Wishlist) -->
			<section class="dash-panel-content" id="tab-saved" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.savedHeading">Saved Guesthouses</h2>
						<p data-i18n="dashboard.savedSub">Stays you've bookmarked for upcoming trips. Ready for quick booking.</p>
					</div>
				</div>

				<div class="saved-grid" id="saved-container">
					<!-- Dynamically rendered via client script -->
				</div>

				<div class="dash-empty-card" id="saved-empty" hidden>
					<span class="dash-empty-icon">
						<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
					</span>
					<h3 data-i18n="dashboard.noSavedTitle">Your wishlist is currently empty</h3>
					<p data-i18n="dashboard.noSavedDesc">Click the heart icon on any guesthouse card while exploring to save it to your dashboard.</p>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" data-i18n="dashboard.exploreStays">Explore Stays to Save ↗</a>
				</div>
			</section>

			<!-- TAB 3: Guides & Rides (Executive Compact Layout) -->
			<section class="dash-panel-content" id="tab-services" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.servicesHeading">Guides &amp; Transport Services</h2>
						<p data-i18n="dashboard.servicesSub">Local guides booked and airport pick &amp; drop travel arrangements.</p>
					</div>
					<button type="button" class="btn-primary-pill" id="btn-services-tab-schedule-top" style="height:36px; font-size:12px; padding:0 16px;">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
						<span>Schedule Service</span>
					</button>
				</div>

				<div class="guides-exec-list" id="services-tab-container">
					<!-- Dynamically rendered via client script -->
				</div>

				<div class="dash-empty-card" id="services-tab-empty" hidden>
					<span class="dash-empty-icon">
						<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
					</span>
					<h3 data-i18n="dashboard.noServicesScheduled">No travel assistants or chauffeurs scheduled yet.</h3>
					<p>Pair your verified Dhaka guesthouse stay with licensed local tour guides, airport chauffeurs, and personal assistants.</p>
					<button type="button" class="btn-primary-pill" id="btn-services-tab-schedule" style="margin-top:8px;">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
						<span>Schedule Guide / Ride</span>
					</button>
				</div>
			</section>

			<!-- TAB 4: Account Settings -->
			<section class="dash-panel-content" id="tab-settings" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.settingsTitle">Account Profile &amp; Preferences</h2>
						<p data-i18n="dashboard.settingsSubtitle">Manage your traveler identity, contact details, language preferences, and membership privileges.</p>
					</div>
				</div>

				<!-- Alert feedback banner for settings -->
				<div id="settings-status-banner" class="auth-alert" style="margin-bottom: 20px; display: none;" role="alert"></div>

				<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; align-items: start;">
					
					<!-- CARD 1: Visual Identity & Personal Profile -->
					<div class="dash-hero-card" style="margin-bottom:0;">
						<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom: 16px;">
							<h3 style="font-size: 16px; font-weight: 700; margin:0;" data-i18n="dashboard.settingsTitle">Traveler Identity &amp; Avatar</h3>
							<span id="settings-account-type-badge" class="dash-tier-badge is-vip" style="font-size:11px;">Standard Account</span>
						</div>

						<!-- Avatar & Gender Display -->
						<div style="display:flex; align-items:center; gap: 16px; padding: 14px; border-radius: 12px; background: var(--dash-surface-soft); margin-bottom: 16px;">
							<div style="position:relative; width: 64px; height: 64px; flex-shrink: 0;">
								<img id="settings-avatar-img" src="/assets/icons/user.png" alt="Profile" style="width:100%; height:100%; border-radius:50%; object-fit:cover; border:2px solid var(--dash-brand);" />
							</div>
							<div style="flex:1;">
								<div style="display:flex; align-items:center; gap:8px;">
									<strong id="settings-avatar-label" style="font-size: 13px; color: var(--dash-ink);">Default Avatar</strong>
								</div>
								<p id="settings-avatar-desc" style="font-size: 11px; color: var(--dash-muted); margin: 2px 0 8px;">Changes dynamically based on your gender or custom uploaded picture.</p>
								<div style="display:flex; gap: 8px; flex-wrap:wrap;">
									<button type="button" id="btn-trigger-photo-upload" class="dash-link" style="padding: 4px 10px; font-size: 11px; font-weight: 600; border-radius: 6px; border: 1px solid var(--dash-border); background: var(--dash-surface);">
										📷 Upload Photo
									</button>
									<button type="button" id="btn-reset-avatar" class="dash-link" style="padding: 4px 10px; font-size: 11px; font-weight: 600; border-radius: 6px; border: 1px solid var(--dash-border); background: var(--dash-surface); color: var(--dash-muted);">
										↺ Use Gender Icon
									</button>
									<input type="file" id="settings-photo-input" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;" />
								</div>
							</div>
						</div>

						<!-- Gender Preference Selector -->
						<div style="margin-bottom: 14px;">
							<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted); display:block; margin-bottom:6px;">Gender Preference (Drives Default Icon)</label>
							<div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px;" id="settings-gender-group">
								<button type="button" class="gender-btn" data-gender="male" style="display:flex; align-items:center; justify-content:center; gap:6px; padding: 10px; border-radius:8px; border:1px solid var(--dash-border); background: var(--dash-surface-soft); font-size:12px; font-weight:600; cursor:pointer; color:var(--dash-ink);">
									<img src="/assets/icons/user-male.png" alt="" style="width:16px; height:16px;" />
									<span>Male</span>
								</button>
								<button type="button" class="gender-btn" data-gender="female" style="display:flex; align-items:center; justify-content:center; gap:6px; padding: 10px; border-radius:8px; border:1px solid var(--dash-border); background: var(--dash-surface-soft); font-size:12px; font-weight:600; cursor:pointer; color:var(--dash-ink);">
									<img src="/assets/icons/user-female.png" alt="" style="width:16px; height:16px;" />
									<span>Female</span>
								</button>
								<button type="button" class="gender-btn" data-gender="other" style="display:flex; align-items:center; justify-content:center; gap:6px; padding: 10px; border-radius:8px; border:1px solid var(--dash-border); background: var(--dash-surface-soft); font-size:12px; font-weight:600; cursor:pointer; color:var(--dash-ink);">
									<img src="/assets/icons/user.png" alt="" style="width:16px; height:16px;" />
									<span>Other</span>
								</button>
							</div>
						</div>

						<div style="display:grid; gap: 12px;">
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.fullName">Display Name</label>
								<input type="text" id="edit-name" value="" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit;" placeholder="Your Name" />
							</div>
							<div>
								<div style="display:flex; justify-content:space-between; align-items:center;">
									<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.emailAddress">Email Address</label>
									<span id="google-linked-indicator" style="font-size:10px; font-weight:700; color:#4285F4; display:none;">✓ Google Linked</span>
								</div>
								<input type="email" id="edit-email" value="" readonly style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-muted); font:inherit;" />
							</div>
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.contactPhone">Contact Phone (WhatsApp / Calls)</label>
								<input type="tel" id="edit-phone" value="" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit;" placeholder="+880 1712 345678" />
							</div>
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.languagePref">Language &amp; Regional Display</label>
								<select id="settings-lang-select" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit; font-weight:600; cursor:pointer;">
								</select>
							</div>
						</div>
					</div>

