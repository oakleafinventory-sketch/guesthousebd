		<div class="dash-modal-backdrop" id="modal-biometric-auth" role="dialog" aria-modal="true" aria-labelledby="modal-bio-title">
			<div class="dash-modal-sheet" style="max-width: 440px; text-align: center;">
				<div class="modal-header-row" style="justify-content: center; position: relative;">
					<div class="modal-header-content" style="text-align: center;">
						<small id="modal-bio-eyebrow" style="color: var(--dash-brand); font-weight: 700; letter-spacing: 0.08em;">BIOMETRIC SECURITY GATE</small>
						<h3 id="modal-bio-title" style="font-size: 18px; margin-top: 4px;">Fingerprint Authorization</h3>
					</div>
					<button type="button" class="modal-close-btn" data-close-modal="modal-biometric-auth" aria-label="Close modal" style="position: absolute; right: 0; top: 0;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
				</div>
				<div class="modal-body-content" style="padding: 24px 16px; display: flex; flex-direction: column; align-items: center; gap: 16px;">
					<div class="bio-scanner-card" id="bio-scanner-card" style="position: relative; width: 104px; height: 104px; border-radius: 50%; background: var(--dash-surface-soft); border: 2px dashed var(--dash-brand); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease;">
						<svg class="bio-fingerprint-svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--dash-brand)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 3"/>
							<path d="M14 13.12c0 2.38 0 6.38-1 8.88"/>
							<path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/>
							<path d="M2 12a10 10 0 0 1 18-6"/>
							<path d="M2 16h.01"/>
							<path d="M21.8 16c.2-2 .131-5.354 0-6"/>
							<path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/>
							<path d="M8.65 22c.21-.66.45-1.32.57-2"/>
							<path d="M9 6.8a6 6 0 0 1 9 5.2v2"/>
						</svg>
					</div>

					<div>
						<h4 id="bio-service-target" style="font-size: 14px; font-weight: 700; color: var(--dash-ink); margin: 0 0 4px;">Authorizing Tour Guide Booking</h4>
						<p id="bio-prompt-text" style="font-size: 12px; color: var(--dash-muted); margin: 0; line-height: 1.5;">Touch your fingerprint sensor (Touch ID / Windows Hello) or tap the scanner above to verify your identity.</p>
					</div>

					<div class="bio-status-pill" id="bio-status-pill" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 999px; background: rgba(230, 24, 61, 0.08); color: var(--dash-brand); font-size: 11px; font-weight: 600;">
						<span class="bio-status-dot" id="bio-status-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--dash-brand); display: inline-block;"></span>
						<span id="bio-status-text">Sensor Waiting for Fingerprint...</span>
					</div>
				</div>
				<div class="modal-footer-row" style="justify-content: center; gap: 12px;">
					<button type="button" class="btn-modal-ghost" data-close-modal="modal-biometric-auth">Cancel</button>
					<button type="button" class="btn-modal-primary" id="btn-trigger-bio-scan" style="background: var(--dash-brand);">
						<span>Touch to Verify (Simulate)</span>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
					</button>
				</div>
			</div>
		</div>

		<SiteFooter />
		<AuthModal />
	</div>
</PageLayout>

<script>
	import i18next from 'i18next';
	import { languages, resources } from '../../i18n/locales.js';
	import { authManager, resolveAvatarUrl, type UserProfile, type BookingRecord, type SavedStayRecord, type TourGuideService, type DriverService, type StayBookedService } from '../../scripts/auth';
	import servicesData from '../../data/services.json';

	const unauthScreen = document.getElementById('dash-unauth');
	const authMain = document.getElementById('dash-authenticated');
	const logoutBtn = document.getElementById('dash-logout');

	// Profile elements
	const userAvatarLarge = document.getElementById('user-avatar-large') as HTMLImageElement | null;
	const userDisplayTitle = document.getElementById('user-display-title');
	const userTierBadge = document.getElementById('user-tier-badge');
	const userEmailText = document.getElementById('user-email-text');
	const userPerkSummary = document.getElementById('user-perk-summary');
	const editName = document.getElementById('edit-name') as HTMLInputElement | null;
	const editEmail = document.getElementById('edit-email') as HTMLInputElement | null;

	// Stat elements
	const statBookings = document.getElementById('stat-bookings');
	const statSaved = document.getElementById('stat-saved');
	const tabBadgeBookings = document.getElementById('tab-badge-bookings');
	const tabBadgeSaved = document.getElementById('tab-badge-saved');

	// Containers
	const bookingsContainer = document.getElementById('bookings-container');
	const bookingsEmpty = document.getElementById('bookings-empty');
	const savedContainer = document.getElementById('saved-container');
	const savedEmpty = document.getElementById('saved-empty');

	// Active modal context
	let activeBookingId: string | null = null;
	let selectedCategory: string = 'all';
	let selectedProviderId: string = servicesData.providers[0]?.id || '';
	let activePaymentData: { bookingId: string; serviceId: string; price: number; title: string; providerName: string } | null = null;

	// i18n setup & helpers
	const getSavedLang = () => {
		try {
			return localStorage.getItem('guesthouse-language') || 'en';
		} catch {
			return 'en';
		}
	};

	let currentLang = getSavedLang();
	const dashI18n = i18next.createInstance();
	dashI18n.init({
		lng: currentLang,
		fallbackLng: 'en',
		resources,
		interpolation: { escapeValue: false },
		initImmediate: false
	});

	const t = (key: string, options?: any) => dashI18n.t(key, options);
	const getLocaleInfo = () => languages.find((l) => l.code === dashI18n.language) || languages[0];

	// Settings tab language select
	const settingsLangSelect = document.getElementById('settings-lang-select') as HTMLSelectElement | null;

	function populateLanguageUI() {
		if (settingsLangSelect) {
			settingsLangSelect.innerHTML = languages
				.map((l: any) => `<option value="${l.code}" ${l.code === dashI18n.language ? 'selected' : ''}>${l.label} (${l.code.toUpperCase()})</option>`)
				.join('');
		}
	}

	function applyDashboardTranslations() {
		document.documentElement.lang = getLocaleInfo().htmlLang;
		document.title = t('dashboard.title');

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const key = el.dataset.i18n;
			if (key) {
				el.textContent = t(key);
			}
		});

		document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach((el) => {
			const key = el.dataset.i18nPlaceholder;
			if (key) {
				el.placeholder = t(key);
			}
		});

		document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
			const key = el.dataset.i18nAriaLabel;
			if (key) {
				el.setAttribute('aria-label', t(key));
			}
		});

		populateLanguageUI();
	}

	function changeDashboardLanguage(code: string) {
		if (!languages.some((l) => l.code === code)) return;
		currentLang = code;
		try {
			localStorage.setItem('guesthouse-language', code);
		} catch {}
		dashI18n.changeLanguage(code);
		applyDashboardTranslations();
		window.dispatchEvent(new CustomEvent('guesthouse:language-changed', { detail: { language: code } }));
		const user = authManager.getUser();
		renderDashboard(user);
	}

	settingsLangSelect?.addEventListener('change', () => {
		if (settingsLangSelect.value) {
			changeDashboardLanguage(settingsLangSelect.value);
		}
	});

	window.addEventListener('guesthouse:language-changed', (e: any) => {
		const lang = e?.detail?.language;
		if (lang && lang !== dashI18n.language) {
			dashI18n.changeLanguage(lang);
			applyDashboardTranslations();
			const user = authManager.getUser();
			renderDashboard(user);
		}
	});

	window.addEventListener('storage', (e) => {
		if (e.key === 'guesthouse-language' && e.newValue && e.newValue !== dashI18n.language) {
			dashI18n.changeLanguage(e.newValue);
			applyDashboardTranslations();
			const user = authManager.getUser();
			renderDashboard(user);
		}
	});

	// Initial translation pass
	applyDashboardTranslations();

	// Theme toggle
	const themeBtn = document.querySelector('[data-dashboard-theme-toggle]');
	const themeIcon = document.querySelector('[data-dashboard-theme-icon]');

	function syncTheme() {
		const currentTheme = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		document.documentElement.dataset.theme = currentTheme;
		if (themeIcon) themeIcon.textContent = currentTheme === 'dark' ? '☀' : '☾';
	}
	syncTheme();

	themeBtn?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('guesthouse-theme', next);
		} catch {}
		syncTheme();
	});

	// Modal Controls
	function openModal(id: string) {
		const modal = document.getElementById(id);
		if (modal) {
			modal.classList.add('is-open');
			document.body.style.overflow = 'hidden';
		}
	}

	function closeModal(id: string) {
		const modal = document.getElementById(id);
		if (modal) {
			modal.classList.remove('is-open');
			document.body.style.overflow = '';
		}
	}

	// Close buttons
	document.querySelectorAll<HTMLButtonElement>('[data-close-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetId = btn.dataset.closeModal;
			if (targetId) closeModal(targetId);
		});
	});

	// Backdrop click close
	document.querySelectorAll<HTMLElement>('.dash-modal-backdrop').forEach((backdrop) => {
		backdrop.addEventListener('click', (e) => {
			if (e.target === backdrop) {
				closeModal(backdrop.id);
			}
		});
	});

	// ESC key close
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			document.querySelectorAll('.dash-modal-backdrop.is-open').forEach((m) => {
				closeModal(m.id);
			});
		}
	});

	function renderDashboard(user: UserProfile | null) {
		if (!user) {
			if (unauthScreen) unauthScreen.hidden = false;
			if (authMain) authMain.hidden = true;
			return;
		}

		if (unauthScreen) unauthScreen.hidden = true;
		if (authMain) authMain.hidden = false;

		// Recompute resolved avatar using gender/customAvatar hierarchy
		const avatarUrl = resolveAvatarUrl(user);

		// Populate Profile Header
		if (userAvatarLarge) {
			userAvatarLarge.src = avatarUrl;
			userAvatarLarge.alt = user.name;
		}
		if (userDisplayTitle) userDisplayTitle.textContent = `${t('dashboard.welcomeBack')}, ${user.name}`;
		if (userTierBadge) {
			userTierBadge.textContent = user.tier;
			userTierBadge.className = `dash-tier-badge is-${user.role}`;
		}
		if (userEmailText) userEmailText.textContent = user.email;
		if (userPerkSummary) userPerkSummary.textContent = `${Math.round(user.discountRate * 100)}% ${t('dashboard.memberDiscountActive')}`;

		// Populate Settings Tab Elements
		const settingsAvatarImg = document.getElementById('settings-avatar-img') as HTMLImageElement | null;
		const settingsAvatarLabel = document.getElementById('settings-avatar-label');
		const settingsAccountBadge = document.getElementById('settings-account-type-badge');
		const googleLinkedIndicator = document.getElementById('google-linked-indicator');
		const googlePwdNotice = document.getElementById('google-password-notice');
		const editNid = document.getElementById('edit-nid') as HTMLInputElement | null;
		const editPassport = document.getElementById('edit-passport') as HTMLInputElement | null;
		const editPhone = document.getElementById('edit-phone') as HTMLInputElement | null;
		const editFingerprint = document.getElementById('edit-fingerprint-toggle') as HTMLInputElement | null;
		const fingerprintStatusLabel = document.getElementById('fingerprint-status-label');

		if (settingsAvatarImg) settingsAvatarImg.src = avatarUrl;
		if (settingsAccountBadge) settingsAccountBadge.textContent = user.tier;

		if (settingsAvatarLabel) {
			if (user.customAvatar) settingsAvatarLabel.textContent = 'Custom Photo Uploaded';
			else if (user.gender === 'male') settingsAvatarLabel.textContent = 'Male Traveler Icon (Active)';
			else if (user.gender === 'female') settingsAvatarLabel.textContent = 'Female Traveler Icon (Active)';
			else settingsAvatarLabel.textContent = 'Standard Traveler Icon (Active)';
		}

		// Gender active selector state
		document.querySelectorAll<HTMLElement>('#settings-gender-group .gender-btn').forEach((btn) => {
			const g = btn.dataset.gender;
			const isMatch = g === user.gender || (!user.gender && g === 'other');
			btn.classList.toggle('is-selected', isMatch);
			if (isMatch) {
				btn.style.borderColor = 'var(--dash-brand)';
				btn.style.background = 'rgba(230, 24, 61, 0.08)';
				btn.style.color = 'var(--dash-brand)';
			} else {
				btn.style.borderColor = 'var(--dash-border)';
				btn.style.background = 'var(--dash-surface-soft)';
				btn.style.color = 'var(--dash-ink)';
			}
		});

		if (editName) editName.value = user.name || '';
		if (editEmail) editEmail.value = user.email || '';
		if (editPhone) editPhone.value = user.phone || '';
		if (editNid) editNid.value = user.nationalId || '';
		if (editPassport) editPassport.value = user.passportNumber || '';
		if (editFingerprint) editFingerprint.checked = Boolean(user.fingerprintEnabled);

		if (fingerprintStatusLabel) {
			fingerprintStatusLabel.textContent = user.fingerprintEnabled
				? 'Status: Active (Enforced for Guides & Assistants)'
				: 'Status: Inactive';
			fingerprintStatusLabel.style.color = user.fingerprintEnabled ? 'var(--dash-emerald)' : 'var(--dash-muted)';
		}

		if (googleLinkedIndicator) {
			googleLinkedIndicator.style.display = user.googleLinked ? 'inline-block' : 'none';
		}
		if (googlePwdNotice) {
			googlePwdNotice.style.display = user.googleLinked ? 'block' : 'none';
		}

		renderBookings();
		renderSavedStays();
		renderServicesTab();
	}

	function renderBookings() {
		const bookings = authManager.getBookings();
		const count = bookings.filter((b) => b.status !== 'cancelled').length;
		if (statBookings) statBookings.textContent = String(count);
		if (tabBadgeBookings) tabBadgeBookings.textContent = String(count);

		if (!bookingsContainer) return;

		if (bookings.length === 0) {
			bookingsContainer.innerHTML = '';
			if (bookingsEmpty) bookingsEmpty.hidden = false;
			return;
		}

		if (bookingsEmpty) bookingsEmpty.hidden = true;

		bookingsContainer.innerHTML = bookings
			.map((b) => {
				const isCancelled = b.status === 'cancelled';
				const services = b.services || [];

				return `
			<article class="booking-card ${isCancelled ? 'is-cancelled' : ''}">
				<div class="booking-image-wrap">
					<img src="${b.stayImage}" alt="${b.stayName}" loading="lazy" />
					<span class="booking-status-tag ${b.status}">
						<span>●</span>
						<span>${b.status.toUpperCase()}</span>
					</span>
				</div>
				<div class="booking-content-wrap">
					<div class="booking-header-row">
						<div>
							<span class="booking-eyebrow">${b.city} · ${b.area}</span>
							<h3 class="booking-stay-title">${b.stayName}</h3>
						</div>
						<div class="booking-code-pill">
							<small>${t('dashboard.confirmationCode')}</small>
							<strong>${b.confirmationCode}</strong>
						</div>
					</div>

					<div class="booking-specs-strip">
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.checkIn')}</span>
							<span class="spec-value">${b.checkIn}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.checkOut')}</span>
							<span class="spec-value">${b.checkOut}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.duration')}</span>
							<span class="spec-value">${b.nights} ${b.nights === 1 ? 'Night' : 'Nights'}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.guests')}</span>
							<span class="spec-value">${b.guests}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.total')}</span>
							<span class="spec-value is-price">$${b.totalPrice} ${b.currency}</span>
						</div>
					</div>

					<!-- Scheduled Services Tab-Based Strip -->
					${(() => {
						const countTransport = services.filter((s) => s.categoryId === 'transport').length;
						const countAssistant = services.filter((s) => s.categoryId === 'travel-assistant' || s.categoryId === 'tour-assistant').length;
						const countGuide = services.filter((s) => s.categoryId === 'tour-guide').length;
						const countExtra = services.filter((s) => s.categoryId === 'extra-services' || s.categoryId === 'amenities').length;

						return services.length > 0
							? `
						<div class="booking-services-strip" id="services-strip-${b.id}">
							<div class="services-strip-header">
								<div class="stay-services-tabs-group" role="tablist">
									<button type="button" class="stay-srv-tab-btn is-active" data-stay-id="${b.id}" data-category="all" role="tab">
										<span>All</span>
										<span class="stay-srv-tab-count">${services.length}</span>
									</button>
									<button type="button" class="stay-srv-tab-btn" data-stay-id="${b.id}" data-category="transport" role="tab">
										<span>Transport</span>
										<span class="stay-srv-tab-count">${countTransport}</span>
									</button>
									<button type="button" class="stay-srv-tab-btn" data-stay-id="${b.id}" data-category="travel-assistant" role="tab">
										<span>Travel Assistant</span>
										<span class="stay-srv-tab-count">${countAssistant}</span>
									</button>
									<button type="button" class="stay-srv-tab-btn" data-stay-id="${b.id}" data-category="tour-guide" role="tab">
										<span>Tour Guide</span>
										<span class="stay-srv-tab-count">${countGuide}</span>
									</button>
									<button type="button" class="stay-srv-tab-btn" data-stay-id="${b.id}" data-category="extra-services" role="tab">
										<span>Extra services</span>
										<span class="stay-srv-tab-count">${countExtra}</span>
									</button>
								</div>
								<button type="button" class="btn-action-pill btn-service-add" style="height:28px; font-size:11px; padding:0 10px; margin-left:auto;" data-open-scheduler="${b.id}">
									<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
									<span>${t('dashboard.addAnotherService')}</span>
								</button>
							</div>

							<div class="services-items-grid" id="services-grid-${b.id}">
								${services
									.map((s) => {
										const isPaid = s.paymentStatus === 'paid';
										const isAck = !!s.acknowledgedByProvider;
										const isAvailable = isPaid && isAck;
										const cardClass = !isPaid ? 'is-unpaid' : !isAck ? 'is-pending-flag' : 'is-available';
										const cleanPhone = s.providerPhone.replace(/\s+/g, '');
										const digits = s.providerPhone.replace(/[^0-9]/g, '');

										let normCat = 'transport';
										if (s.categoryId === 'travel-assistant' || s.categoryId === 'tour-assistant') normCat = 'travel-assistant';
										else if (s.categoryId === 'tour-guide') normCat = 'tour-guide';
										else if (s.categoryId === 'extra-services' || s.categoryId === 'amenities') normCat = 'extra-services';

										return `
									<div class="service-item-card ${cardClass}" data-service-cat="${normCat}">
										<div class="service-item-main">
											<div class="service-item-left">
												<div class="service-avatar-wrap">
													<img src="${s.providerAvatar}" alt="${s.providerName}" class="service-item-avatar" />
													<span class="service-verified-badge" title="Verified Assistant">✓</span>
												</div>
												<div class="service-item-details">
													<span class="service-item-tag">${s.categoryName}</span>
													<strong class="service-item-name">${s.providerName}</strong>
													<span class="service-item-title">${s.title}</span>
												</div>
											</div>

											<div class="service-item-schedule">
												<div class="service-schedule-row">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
													<span>${s.date}</span>
												</div>
												<div class="service-schedule-row">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
													<span>${s.timeSlotLabel}</span>
												</div>
												<span class="service-rate-label">$${s.price} ${s.currency || 'USD'}</span>
											</div>

											<div class="service-item-right">
												${
													!isPaid
														? `<span class="service-status-pill is-unpaid" title="Payment required to activate service proposal">🔒 ${t('dashboard.guardPaymentPending')}</span>`
														: !isAck
															? `<span class="service-status-pill is-pending" title="Payment verified in escrow! Awaiting provider acknowledgment">⏳ ${t('dashboard.guardAwaitingFlag')}</span>`
															: `<span class="service-status-pill is-available" title="Confirmed & Ready"><span class="pulse-indicator"></span><span>${t('dashboard.guardAvailable')}</span></span>`
												}

												${
													isAvailable
														? `
													<a href="tel:${cleanPhone}" class="btn-chip-call" title="Call ${s.providerName} directly">
