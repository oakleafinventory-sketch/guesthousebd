									<span>${t('dashboard.contactLocked')}</span>
								</span>
								<button type="button" class="btn-chip-ack" data-ack-service="${s.booking.id}:${s.id}" title="Demo Provider Action: Click to flag acknowledgment as ${s.providerName}">
									<span>${t('dashboard.providerFlagBtn')}</span>
								</button>
								`
							}

							<button type="button" class="btn-chip-delete" data-remove-stay-service="${s.booking.id}:${s.id}" title="Cancel this scheduled service">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
							</button>
						</div>
					</div>
				</div>

				<div class="guide-exec-footer">
					<div style="display:flex; align-items:center; gap:6px;">
						<span style="font-weight:600; color:var(--dash-ink);">📍 Meeting Point:</span>
						<span>Guesthouse lobby / main gate at designated time. Provider presents verified GBD credentials.</span>
					</div>
					<div>
