				const cleanPhone = s.providerPhone.replace(/\s+/g, '');
				const digits = s.providerPhone.replace(/[^0-9]/g, '');

				const policy = authManager.canCancelService(s);

				let normCat = 'transport';
				if (s.categoryId === 'travel-assistant' || s.categoryId === 'tour-assistant') normCat = 'travel-assistant';
				else if (s.categoryId === 'tour-guide') normCat = 'tour-guide';
				else if (s.categoryId === 'extra-services' || s.categoryId === 'amenities') normCat = 'extra-services';

				return `
