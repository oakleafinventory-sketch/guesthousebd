								? `<span style="color:var(--dash-emerald); font-weight:600;">✓ Escrow cleared &amp; provider ready</span>`
								: !isPaid
									? `<span style="color:var(--dash-brand); font-weight:600;">🔒 Payment pending ($${s.price})</span>`
									: `<span style="color:#2563eb; font-weight:600;">⏳ Paid · Awaiting provider flag</span>`
						}
