						<div class="guide-exec-spec">
							<span class="guide-exec-spec-label">Service Date</span>
							<span class="guide-exec-spec-val">📅 ${s.date}</span>
						</div>
						<div class="guide-exec-spec">
							<span class="guide-exec-spec-label">Assigned Slot</span>
							<span class="guide-exec-spec-val">⏰ ${s.timeSlotLabel}</span>
						</div>
						<div class="guide-exec-spec">
							<span class="guide-exec-spec-label">Rate (VIP Perk)</span>
							<span class="guide-exec-spec-val is-rate">$${s.price} ${s.currency || 'USD'}</span>
