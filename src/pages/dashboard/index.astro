				servicesContainer.querySelectorAll<HTMLElement>('.guide-exec-card').forEach((card) => {
					const cardCat = card.dataset.serviceCat || '';
					if (cat === 'all' || cardCat === cat) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});
			});
		});

		// Attach Listeners in Tab 3 (payments, ack, delete with 4-hour policy)
		servicesContainer.querySelectorAll<HTMLButtonElement>('[data-remove-stay-service]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.removeStayService;
				if (!raw) return;
				const [bookingId, serviceId] = raw.split(':');
				const b = authManager.getBookings().find((item) => item.id === bookingId);
				const s = (b?.services || []).find((item) => item.id === serviceId);
				if (!s) return;

				const policy = authManager.canCancelService(s);
				let confirmMsg = '';
				if (policy.canCancel) {
					confirmMsg = `Cancel scheduled service "${s.title}"?\n\n✓ Eligible for 100% full refund (more than 4 hours before scheduled service).\nFree cancellation until: ${policy.deadlineFormatted}.`;
				} else {
					confirmMsg = `⚠️ Notice: Cancellation within 4 hours\n\n${policy.reason}\n\nDo you still wish to cancel this scheduled service without a refund?`;
				}

				if (confirm(confirmMsg)) {
					const res = authManager.removeServiceFromStay(bookingId, serviceId);
					alert(res.message);
					renderBookings();
					renderServicesTab();
				}
			});
		});

		servicesContainer.querySelectorAll<HTMLButtonElement>('[data-ack-service]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.ackService;
				if (!raw) return;
				const [bookingId, serviceId] = raw.split(':');
				authManager.toggleServiceAcknowledgment(bookingId, serviceId);
				renderBookings();
				renderServicesTab();
			});
		});

		servicesContainer.querySelectorAll<HTMLButtonElement>('[data-open-payment]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const raw = btn.dataset.openPayment;
				if (!raw) return;
				const [bookingId, serviceId, priceStr, titleEnc, providerNameEnc, avatarEnc, catNameEnc] = raw.split(':');
				const title = decodeURIComponent(titleEnc || '');
				const providerName = decodeURIComponent(providerNameEnc || '');
				const avatar = decodeURIComponent(avatarEnc || '');
				const catName = decodeURIComponent(catNameEnc || '');
				const price = parseFloat(priceStr) || 0;

				activePaymentData = { bookingId, serviceId, price, title, providerName };

				const titleEl = document.getElementById('pay-service-title');
				const nameEl = document.getElementById('pay-provider-name');
				const avatarEl = document.getElementById('pay-provider-avatar') as HTMLImageElement | null;
				const catEl = document.getElementById('pay-service-category');
				const amountEl = document.getElementById('pay-amount-display');

				if (titleEl) titleEl.textContent = title;
				if (nameEl) nameEl.textContent = `Proposed to ${providerName}`;
				if (avatarEl && avatar) avatarEl.src = avatar;
				if (catEl) catEl.textContent = catName;
				if (amountEl) amountEl.textContent = `$${price} USD`;

				openModal('modal-service-payment');
			});
		});
	}

	// Schedule Service Buttons in Tab 3
	const openFirstAvailableScheduler = () => {
		const bookings = authManager.getBookings().filter((b) => b.status !== 'cancelled');
		if (bookings.length === 0) {
			alert('Please book a guesthouse first before scheduling local guides or transport.');
			return;
		}
		const first = bookings[0];
		const schedulerBtn = document.querySelector(`[data-open-scheduler="${first.id}"]`) as HTMLButtonElement | null;
		if (schedulerBtn) {
			schedulerBtn.click();
		}
	};

	document.getElementById('btn-services-tab-schedule')?.addEventListener('click', openFirstAvailableScheduler);
	document.getElementById('btn-services-tab-schedule-top')?.addEventListener('click', openFirstAvailableScheduler);

	// ==========================================
	// Traveler Settings, Profile & Biometric Logic
	// ==========================================
	const settingsAlert = document.getElementById('settings-status-banner');
	function showSettingsAlert(msg: string, isSuccess = false) {
		if (!settingsAlert) return;
		settingsAlert.textContent = msg;
		settingsAlert.className = `auth-alert ${isSuccess ? 'is-success' : ''}`;
		settingsAlert.style.display = 'block';
		settingsAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		setTimeout(() => {
			if (settingsAlert) settingsAlert.style.display = 'none';
		}, 4000);
	}

	// 1. Photo Upload & Reset
	const btnTriggerUpload = document.getElementById('btn-trigger-photo-upload');
	const photoInput = document.getElementById('settings-photo-input') as HTMLInputElement | null;
	const btnResetAvatar = document.getElementById('btn-reset-avatar');

	btnTriggerUpload?.addEventListener('click', () => {
		photoInput?.click();
	});

	photoInput?.addEventListener('change', () => {
		const file = photoInput.files?.[0];
		if (!file) return;

		if (file.size > 2 * 1024 * 1024) {
			showSettingsAlert('Image file size must be less than 2MB.', false);
			return;
		}

		const reader = new FileReader();
		reader.onload = (e) => {
			const dataUrl = e.target?.result as string;
			if (dataUrl) {
				authManager.updateProfile({ customAvatar: dataUrl });
				showSettingsAlert('Custom profile photo uploaded and updated!', true);
			}
		};
		reader.readAsDataURL(file);
	});

	btnResetAvatar?.addEventListener('click', () => {
		const user = authManager.getUser();
		if (!user) return;
		authManager.updateProfile({ customAvatar: undefined });
		showSettingsAlert(`Custom photo cleared. Switched back to ${user.gender || 'standard'} traveler icon.`, true);
	});

	// 2. Gender Preference Selection
	document.querySelectorAll<HTMLElement>('#settings-gender-group .gender-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const gender = btn.dataset.gender as 'male' | 'female' | 'other';
			authManager.updateProfile({ gender });
			showSettingsAlert(`Gender preference set to ${gender.toUpperCase()}. Dynamic user icon updated!`, true);
		});
	});

	// 3. Biometric Sensor Testing
	document.getElementById('btn-test-sensor')?.addEventListener('click', () => {
		resetBiometricModal('Biometric Device Sensor Diagnostic');
		pendingBiometricAction = () => {
			showSettingsAlert('Biometric sensor test passed! Device is verified for guided tour dispatches.', true);
		};
		openModal('modal-biometric-auth');
	});

	// 4. Fingerprint Toggle Live Status
	const editFingerprintToggle = document.getElementById('edit-fingerprint-toggle') as HTMLInputElement | null;
	editFingerprintToggle?.addEventListener('change', () => {
		const label = document.getElementById('fingerprint-status-label');
		if (label) {
			label.textContent = editFingerprintToggle.checked
				? 'Status: Active (Enforced for Guides & Assistants)'
				: 'Status: Inactive';
			label.style.color = editFingerprintToggle.checked ? 'var(--dash-emerald)' : 'var(--dash-muted)';
		}
	});

	// 5. Update Password
	document.getElementById('btn-update-password')?.addEventListener('click', async () => {
		const newPwd = (document.getElementById('edit-new-password') as HTMLInputElement)?.value;
		const confirmPwd = (document.getElementById('edit-confirm-password') as HTMLInputElement)?.value;

		if (!newPwd || newPwd.length < 6) {
			showSettingsAlert('New password must be at least 6 characters.', false);
			return;
		}
		if (newPwd !== confirmPwd) {
			showSettingsAlert('Password confirmation does not match.', false);
			return;
		}

		try {
			await authManager.updatePassword(newPwd);
			const newPwdEl = document.getElementById('edit-new-password') as HTMLInputElement | null;
			const confirmPwdEl = document.getElementById('edit-confirm-password') as HTMLInputElement | null;
			if (newPwdEl) newPwdEl.value = '';
			if (confirmPwdEl) confirmPwdEl.value = '';
			showSettingsAlert('Password changed successfully!', true);
		} catch (err: any) {
			showSettingsAlert(err.message || 'Failed to update password.', false);
		}
	});

	// 6. Save Profile Changes Action
	document.getElementById('btn-save-profile')?.addEventListener('click', () => {
		const nameInput = document.getElementById('edit-name') as HTMLInputElement | null;
		const phoneInput = document.getElementById('edit-phone') as HTMLInputElement | null;
		const nidInput = document.getElementById('edit-nid') as HTMLInputElement | null;
		const passportInput = document.getElementById('edit-passport') as HTMLInputElement | null;
		const bioToggle = document.getElementById('edit-fingerprint-toggle') as HTMLInputElement | null;

		const name = nameInput?.value.trim() || 'Traveler';
		const phone = phoneInput?.value.trim() || '';
		const nationalId = nidInput?.value.trim() || '';
		const passportNumber = passportInput?.value.trim() || '';
		const fingerprintEnabled = Boolean(bioToggle?.checked);

		authManager.updateProfile({
			name,
			phone,
			nationalId,
			passportNumber,
			fingerprintEnabled
		});

		showSettingsAlert('Profile details, contact number, travel documents, and security preferences saved successfully!', true);
	});

	// Tab Switching logic
	const tabButtons = document.querySelectorAll<HTMLButtonElement>('.dash-tab-btn');
	const tabPanels = document.querySelectorAll<HTMLElement>('.dash-panel-content');

	function activateTab(tabId: string) {
		tabButtons.forEach((btn) => {
			const isMatch = btn.dataset.tabTarget === tabId;
			btn.classList.toggle('is-active', isMatch);
		});
		tabPanels.forEach((panel) => {
			panel.hidden = panel.id !== tabId;
		});
	}

	tabButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetId = btn.dataset.tabTarget;
			if (targetId) activateTab(targetId);
		});
	});

	// Check hash in URL
	if (window.location.hash) {
		const hash = window.location.hash.replace('#', '');
		if (hash === 'saved') activateTab('tab-saved');
		else if (hash === 'bookings') activateTab('tab-bookings');
		else if (hash === 'services') activateTab('tab-services');
		else if (hash === 'settings') activateTab('tab-settings');
	}

	// Sign out action
	logoutBtn?.addEventListener('click', async () => {
		await authManager.signOut();
		window.location.href = '/';
	});

	// Membership Tier Demo Switcher
	document.querySelectorAll<HTMLButtonElement>('[data-switch-role]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const role = btn.dataset.switchRole as 'traveler' | 'vip' | 'host';
			await authManager.signInWithDemo(role);
		});
	});

	// Initial subscription
	authManager.subscribe(renderDashboard);
	window.addEventListener('guesthouse:bookings-changed', renderBookings);
	window.addEventListener('guesthouse:saved-changed', renderSavedStays);
</script>
