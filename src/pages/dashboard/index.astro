						<label style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--dash-muted);" data-i18n="schedModal.paymentActivation">Payment &amp; Guard Activation</label>
						<div class="schedule-payment-choice">
							<label class="payment-radio-option">
								<input type="radio" name="sched-pay-choice" value="now" checked />
								<div>
									<strong data-i18n="schedModal.payNowOption">Pay Now &amp; Dispatch</strong>
									<small data-i18n="schedModal.payNowSub">Settle member rate now. Booking is immediately flagged to assistant.</small>
								</div>
							</label>
							<label class="payment-radio-option">
								<input type="radio" name="sched-pay-choice" value="later" />
								<div>
									<strong data-i18n="schedModal.payLaterOption">Reserve &amp; Pay Later</strong>
									<small data-i18n="schedModal.payLaterSub">Hold schedule slot. Contact details remain locked until payment.</small>
								</div>
							</label>
						</div>
					</div>

					<!-- Rate summary with VIP Discount -->
					<div class="modal-detail-card" style="background:rgba(5, 150, 105, 0.06); border-color:rgba(5, 150, 105, 0.25);">
						<span class="detail-label" style="color:var(--dash-emerald);" data-i18n="schedModal.rateSummary">Total (Member Perk Applied)</span>
						<div class="detail-value" id="sched-price-summary" style="color:var(--dash-ink); font-size:14px;">
							Rate: <strong>$25 USD</strong> (15% VIP Discount Applied)
						</div>
					</div>
				</div>
				<div class="modal-footer-row">
					<button type="button" class="btn-modal-ghost" data-close-modal="modal-schedule-service" data-i18n="schedModal.cancelBtn">Cancel</button>
					<button type="button" class="btn-modal-primary" id="btn-confirm-scheduled-service">
						<span data-i18n="schedModal.confirmBtn">Confirm &amp; Schedule Service</span>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
					</button>
				</div>
			</div>
		</div>

		<!-- MODAL 6: Service Payment & Guard Release -->
		<div class="dash-modal-backdrop" id="modal-service-payment" role="dialog" aria-modal="true" aria-labelledby="modal-pay-title">
			<div class="dash-modal-sheet" style="max-width: 500px;">
				<div class="modal-header-row">
					<div class="modal-header-content">
						<small id="modal-pay-eyebrow" data-i18n="payModal.eyebrow">Gate 1: Payment Settlement</small>
						<h3 id="modal-pay-title" data-i18n="payModal.title">Authorize Service Payment</h3>
					</div>
					<button type="button" class="modal-close-btn" data-close-modal="modal-service-payment" aria-label="Close modal">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
				</div>
				<div class="modal-body-content">
					<div class="modal-detail-card" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
						<div style="display:flex; align-items:center; gap:12px;">
							<img id="pay-provider-avatar" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=200&auto=format&fit=crop&q=80" alt="Provider" style="width:44px; height:44px; border-radius:50%; object-fit:cover; border:2px solid var(--dash-brand);" />
							<div>
								<span id="pay-service-category" style="font-size:10px; font-weight:700; text-transform:uppercase; color:var(--dash-brand); letter-spacing:0.05em;">Tour Assistant</span>
								<h4 id="pay-service-title" style="margin:2px 0 0; font-size:13px; font-weight:700; color:var(--dash-ink);">Old Dhaka Heritage Trail</h4>
								<span id="pay-provider-name" style="font-size:11px; color:var(--dash-muted);">Proposed to Farzana Ahmed</span>
							</div>
						</div>
						<div style="text-align:right;">
							<span style="font-size:10px; text-transform:uppercase; color:var(--dash-muted); font-weight:600; display:block;" data-i18n="payModal.amountDue">Amount Due</span>
							<strong id="pay-amount-display" style="font-size:18px; color:var(--dash-emerald);">$25 USD</strong>
						</div>
					</div>

					<div class="guard-policy-card" style="background:rgba(59, 130, 246, 0.05); border-color:rgba(59, 130, 246, 0.2);">
						<div class="guard-policy-header" style="color:#2563eb;">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
							<span data-i18n="payModal.noticeTitle">Guard Workflow Notice</span>
						</div>
						<p data-i18n="payModal.noticeDesc">Settling this payment clears Gate 1. Your request will be instantly flagged to the assistant for confirmation. Direct contact channels unlock immediately upon acceptance.</p>
					</div>

					<div style="display:flex; flex-direction:column; gap:8px;">
						<label style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--dash-muted);" data-i18n="payModal.chooseMethod">Choose Payment Method</label>
						<div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
							<label style="display:flex; align-items:center; gap:8px; padding:10px; border-radius:8px; border:1px solid var(--dash-border); background:var(--dash-surface-soft); cursor:pointer;">
								<input type="radio" name="pay-method" value="card" checked style="accent-color:var(--dash-brand);" />
								<span style="font-size:12px; font-weight:600; color:var(--dash-ink);" data-i18n="payModal.cardMethod">💳 Card Payment</span>
							</label>
							<label style="display:flex; align-items:center; gap:8px; padding:10px; border-radius:8px; border:1px solid var(--dash-border); background:var(--dash-surface-soft); cursor:pointer;">
								<input type="radio" name="pay-method" value="mfs" style="accent-color:var(--dash-brand);" />
								<span style="font-size:12px; font-weight:600; color:var(--dash-ink);" data-i18n="payModal.mfsMethod">📱 bKash / Nagad</span>
							</label>
						</div>
					</div>

					<div class="modal-detail-card" style="display:flex; flex-direction:column; gap:4px;">
						<span class="detail-label" data-i18n="payModal.protectedTitle">Protected Transaction</span>
						<div style="font-size:11px; color:var(--dash-muted); line-height:1.4;" data-i18n="payModal.protectedDesc">
							🔒 Escrow Shield: Funds are protected and 100% refundable if the provider cannot acknowledge your schedule.
						</div>
					</div>
				</div>
				<div class="modal-footer-row">
					<button type="button" class="btn-modal-ghost" data-close-modal="modal-service-payment" data-i18n="payModal.cancel">Cancel</button>
					<button type="button" class="btn-modal-primary" id="btn-submit-service-payment">
						<span data-i18n="payModal.authorizePay">Authorize &amp; Pay Now</span>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
					</button>
				</div>
			</div>
		</div>

		<SiteFooter />
		<AuthModal />
	</div>
</PageLayout>

<script>
	import i18next from 'i18next';
	import { languages, resources } from '../../i18n/locales.js';
	import { authManager, type UserProfile, type BookingRecord, type SavedStayRecord, type TourGuideService, type DriverService, type StayBookedService } from '../../scripts/auth';
	import servicesData from '../../data/services.json';

	const unauthScreen = document.getElementById('dash-unauth');
	const authMain = document.getElementById('dash-authenticated');
	const logoutBtn = document.getElementById('dash-logout');

	// Profile elements
	const userAvatarLarge = document.getElementById('user-avatar-large') as HTMLImageElement | null;
	const userDisplayTitle = document.getElementById('user-display-title');
	const userTierBadge = document.getElementById('user-tier-badge');
	const userEmailText = document.getElementById('user-email-text');
	const userPerkSummary = document.getElementById('user-perk-summary');
	const editName = document.getElementById('edit-name') as HTMLInputElement | null;
	const editEmail = document.getElementById('edit-email') as HTMLInputElement | null;

	// Stat elements
	const statBookings = document.getElementById('stat-bookings');
	const statSaved = document.getElementById('stat-saved');
	const tabBadgeBookings = document.getElementById('tab-badge-bookings');
	const tabBadgeSaved = document.getElementById('tab-badge-saved');

	// Containers
	const bookingsContainer = document.getElementById('bookings-container');
	const bookingsEmpty = document.getElementById('bookings-empty');
	const savedContainer = document.getElementById('saved-container');
	const savedEmpty = document.getElementById('saved-empty');

	// Active modal context
	let activeBookingId: string | null = null;
	let selectedCategory: string = 'all';
	let selectedProviderId: string = servicesData.providers[0]?.id || '';
	let activePaymentData: { bookingId: string; serviceId: string; price: number; title: string; providerName: string } | null = null;

	// i18n setup & helpers
	const getSavedLang = () => {
		try {
			return localStorage.getItem('guesthouse-language') || 'en';
		} catch {
			return 'en';
		}
	};

	let currentLang = getSavedLang();
	const dashI18n = i18next.createInstance();
	dashI18n.init({
		lng: currentLang,
		fallbackLng: 'en',
		resources,
		interpolation: { escapeValue: false },
		initImmediate: false
	});

	const t = (key: string, options?: any) => dashI18n.t(key, options);
	const getLocaleInfo = () => languages.find((l) => l.code === dashI18n.language) || languages[0];

	// Settings tab language select
	const settingsLangSelect = document.getElementById('settings-lang-select') as HTMLSelectElement | null;

	function populateLanguageUI() {
		if (settingsLangSelect) {
			settingsLangSelect.innerHTML = languages
				.map((l: any) => `<option value="${l.code}" ${l.code === dashI18n.language ? 'selected' : ''}>${l.label} (${l.code.toUpperCase()})</option>`)
				.join('');
		}
	}

	function applyDashboardTranslations() {
		document.documentElement.lang = getLocaleInfo().htmlLang;
		document.title = t('dashboard.title');

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
			const key = el.dataset.i18n;
			if (key) {
				el.textContent = t(key);
			}
		});

		document.querySelectorAll<HTMLInputElement>('[data-i18n-placeholder]').forEach((el) => {
			const key = el.dataset.i18nPlaceholder;
			if (key) {
				el.placeholder = t(key);
			}
		});

		document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
			const key = el.dataset.i18nAriaLabel;
			if (key) {
				el.setAttribute('aria-label', t(key));
			}
		});

		populateLanguageUI();
	}

	function changeDashboardLanguage(code: string) {
		if (!languages.some((l) => l.code === code)) return;
		currentLang = code;
		try {
			localStorage.setItem('guesthouse-language', code);
		} catch {}
		dashI18n.changeLanguage(code);
		applyDashboardTranslations();
		window.dispatchEvent(new CustomEvent('guesthouse:language-changed', { detail: { language: code } }));
		const user = authManager.getUser();
		renderDashboard(user);
	}

	settingsLangSelect?.addEventListener('change', () => {
		if (settingsLangSelect.value) {
			changeDashboardLanguage(settingsLangSelect.value);
		}
	});

	window.addEventListener('guesthouse:language-changed', (e: any) => {
		const lang = e?.detail?.language;
		if (lang && lang !== dashI18n.language) {
			dashI18n.changeLanguage(lang);
			applyDashboardTranslations();
			const user = authManager.getUser();
			renderDashboard(user);
		}
	});

	window.addEventListener('storage', (e) => {
		if (e.key === 'guesthouse-language' && e.newValue && e.newValue !== dashI18n.language) {
			dashI18n.changeLanguage(e.newValue);
			applyDashboardTranslations();
			const user = authManager.getUser();
			renderDashboard(user);
		}
	});

	// Initial translation pass
	applyDashboardTranslations();

	// Theme toggle
	const themeBtn = document.querySelector('[data-dashboard-theme-toggle]');
	const themeIcon = document.querySelector('[data-dashboard-theme-icon]');

	function syncTheme() {
		const currentTheme = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		document.documentElement.dataset.theme = currentTheme;
		if (themeIcon) themeIcon.textContent = currentTheme === 'dark' ? '☀' : '☾';
	}
	syncTheme();

	themeBtn?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('guesthouse-theme', next);
		} catch {}
		syncTheme();
	});

	// Modal Controls
	function openModal(id: string) {
		const modal = document.getElementById(id);
		if (modal) {
			modal.classList.add('is-open');
			document.body.style.overflow = 'hidden';
		}
	}

	function closeModal(id: string) {
		const modal = document.getElementById(id);
		if (modal) {
			modal.classList.remove('is-open');
			document.body.style.overflow = '';
		}
	}

	// Close buttons
	document.querySelectorAll<HTMLButtonElement>('[data-close-modal]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetId = btn.dataset.closeModal;
			if (targetId) closeModal(targetId);
		});
	});

	// Backdrop click close
	document.querySelectorAll<HTMLElement>('.dash-modal-backdrop').forEach((backdrop) => {
		backdrop.addEventListener('click', (e) => {
			if (e.target === backdrop) {
				closeModal(backdrop.id);
			}
		});
	});

	// ESC key close
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			document.querySelectorAll('.dash-modal-backdrop.is-open').forEach((m) => {
				closeModal(m.id);
			});
		}
	});

	function renderDashboard(user: UserProfile | null) {
		if (!user) {
			if (unauthScreen) unauthScreen.hidden = false;
			if (authMain) authMain.hidden = true;
			return;
		}

		if (unauthScreen) unauthScreen.hidden = true;
		if (authMain) authMain.hidden = false;

		// Populate Profile
		if (userAvatarLarge) {
			userAvatarLarge.src = user.avatar;
			userAvatarLarge.alt = user.name;
		}
		if (userDisplayTitle) userDisplayTitle.textContent = `${t('dashboard.welcomeBack')}, ${user.name}`;
		if (userTierBadge) {
			userTierBadge.textContent = user.tier;
			userTierBadge.className = `dash-tier-badge is-${user.role}`;
		}
		if (userEmailText) userEmailText.textContent = user.email;
		if (userPerkSummary) userPerkSummary.textContent = `${Math.round(user.discountRate * 100)}% ${t('dashboard.memberDiscountActive')}`;

		if (editName) editName.value = user.name;
		if (editEmail) editEmail.value = user.email;

		renderBookings();
		renderSavedStays();
	}

	function renderBookings() {
		const bookings = authManager.getBookings();
		const count = bookings.filter((b) => b.status !== 'cancelled').length;
		if (statBookings) statBookings.textContent = String(count);
		if (tabBadgeBookings) tabBadgeBookings.textContent = String(count);

		if (!bookingsContainer) return;

		if (bookings.length === 0) {
			bookingsContainer.innerHTML = '';
			if (bookingsEmpty) bookingsEmpty.hidden = false;
			return;
		}

		if (bookingsEmpty) bookingsEmpty.hidden = true;

		bookingsContainer.innerHTML = bookings
			.map((b) => {
				const isCancelled = b.status === 'cancelled';
				const services = b.services || [];

				return `
			<article class="booking-card ${isCancelled ? 'is-cancelled' : ''}">
				<div class="booking-image-wrap">
					<img src="${b.stayImage}" alt="${b.stayName}" loading="lazy" />
					<span class="booking-status-tag ${b.status}">
						<span>●</span>
						<span>${b.status.toUpperCase()}</span>
					</span>
				</div>
				<div class="booking-content-wrap">
					<div class="booking-header-row">
						<div>
							<span class="booking-eyebrow">${b.city} · ${b.area}</span>
							<h3 class="booking-stay-title">${b.stayName}</h3>
						</div>
						<div class="booking-code-pill">
							<small>${t('dashboard.confirmationCode')}</small>
							<strong>${b.confirmationCode}</strong>
						</div>
					</div>

					<div class="booking-specs-strip">
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.checkIn')}</span>
							<span class="spec-value">${b.checkIn}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.checkOut')}</span>
							<span class="spec-value">${b.checkOut}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.duration')}</span>
							<span class="spec-value">${b.nights} ${b.nights === 1 ? 'Night' : 'Nights'}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.guests')}</span>
							<span class="spec-value">${b.guests}</span>
						</div>
						<div class="spec-item">
							<span class="spec-label">${t('dashboard.total')}</span>
							<span class="spec-value is-price">$${b.totalPrice} ${b.currency}</span>
						</div>
					</div>

					<!-- Scheduled Services Timeline Strip -->
					${
						services.length > 0
							? `
						<div class="booking-services-strip">
							<div class="services-strip-header">
								<span class="services-strip-title">
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
									<span>${t('dashboard.tabServices')} (${services.length})</span>
								</span>
								<button type="button" class="btn-action-pill btn-service-add" style="height:26px; font-size:10px; padding:0 8px;" data-open-scheduler="${b.id}">
									<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
									<span>${t('dashboard.scheduleService')}</span>
								</button>
							</div>
							<div class="services-items-grid">
								${services
									.map((s) => {
										const isPaid = s.paymentStatus === 'paid';
										const isAck = !!s.acknowledgedByProvider;
										const isAvailable = isPaid && isAck;
										const cardClass = !isPaid ? 'is-unpaid' : !isAck ? 'is-pending-flag' : 'is-available';
										const cleanPhone = s.providerPhone.replace(/\s+/g, '');
										const digits = s.providerPhone.replace(/[^0-9]/g, '');

										return `
									<div class="service-chip-card ${cardClass}">
										<div class="service-chip-top">
											<div class="service-chip-main">
												<img src="${s.providerAvatar}" alt="${s.providerName}" class="service-chip-avatar" />
												<div class="service-chip-info">
													<span class="service-chip-tag">${s.categoryName}</span>
													<strong class="service-chip-name">${s.providerName}</strong>
													<span class="service-chip-time">${s.date} · ${s.timeSlotLabel}</span>
												</div>
											</div>
											${
												!isPaid
													? `<span class="service-guard-badge is-unpaid" title="Payment required to activate service proposal">🔒 ${t('dashboard.guardPaymentPending')} ($${s.price})</span>`
													: !isAck
														? `<span class="service-guard-badge is-pending-flag" title="Payment verified! Awaiting proposed assistant's acknowledgment flag">⏳ ${t('dashboard.guardAwaitingFlag')}</span>`
														: `<span class="service-guard-badge is-active" title="Assistant confirmed availability & acknowledged"><span class="pulse-indicator"></span><span>${t('dashboard.guardAvailable')}</span></span>`
											}
										</div>

										<div class="service-chip-bottom">
											${
												isAvailable
													? `
												<div style="display:flex; align-items:center; gap:6px;">
													<a href="tel:${cleanPhone}" class="btn-chip-call" title="Call ${s.providerName} directly">
														<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
														<span>${t('dashboard.call')} ${s.providerName.split(' ')[0]}</span>
													</a>
													<a href="https://wa.me/${digits}" target="_blank" rel="noopener noreferrer" class="btn-chip-call" style="background:#25d366; padding:0 7px;" title="WhatsApp ${s.providerName}">
														<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
													</a>
												</div>
												`
													: !isPaid
														? `
												<span class="service-locked-contact" title="Direct contact is locked until payment is settled and the assistant accepts">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
