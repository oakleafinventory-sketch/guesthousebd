---
import PageLayout from '../../layouts/PageLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import AuthModal from '../../components/AuthModal.astro';
import '../../styles/dashboard.css';
---

<PageLayout title="My Dashboard — GuesthouseBD" description="Manage your bookings, saved wishlists, and member discounts." includeSiteScript={false}>
	<div class="dashboard-page" id="dashboard-root">
		<!-- Top Dashboard Navigation Bar -->
		<header class="dash-topbar">
			<div class="dash-topbar-inner">
				<a href="/" class="dash-brand" aria-label="GuesthouseBD Home">
					<img src="/assets/logo/logo.png" data-theme-logo-light="/assets/logo/logo.png" data-theme-logo-dark="/assets/logo/logo-darkmode.png" alt="GuesthouseBD" />
				</a>

				<nav class="dash-nav-links" aria-label="Quick links">
					<a href="/" class="dash-link"><span>🌍</span> <span data-i18n="nav.all">Explore All</span></a>
					<a href="/guestHouses/dhaka/" class="dash-link"><span>⌂</span> <span data-i18n="nav.stays">Dhaka Stays</span></a>
					<a href="/#ride" class="dash-link"><span>↗</span> <span data-i18n="nav.ride">Pick &amp; drop</span></a>
					<a href="/#people" class="dash-link"><span>✦</span> <span data-i18n="nav.guides">Guides</span></a>
				</nav>

				<div class="dash-user-controls">
					<button class="theme-toggle-btn" type="button" data-dashboard-theme-toggle aria-label="Switch theme">
						<span data-dashboard-theme-icon>☾</span>
					</button>
					<button type="button" class="dash-logout-btn" id="dash-logout">
						<span>🚪</span>
						<span data-i18n="nav.signOut">Sign Out</span>
					</button>
				</div>
			</div>
		</header>

		<!-- Unauthenticated Gatekeeper Screen -->
		<section class="dash-unauth-screen" id="dash-unauth" hidden style="display:flex; justify-content:center; align-items:center; min-height:65vh; padding:32px 16px;">
			<div class="dash-empty-card" style="max-width: 460px; width:100%; padding: 42px 28px;">
				<span class="dash-empty-icon">🔒</span>
				<h1 style="font-size:22px; font-weight:700; margin-bottom:8px;" data-i18n="dashboard.unauthTitle">Member Access Required</h1>
				<p style="margin-bottom:24px;" data-i18n="dashboard.unauthDesc">Sign in to your GuesthouseBD account to access your personal reservations, saved stays wishlist, and exclusive member discounts.</p>
				<div style="display:flex; flex-direction:column; gap:10px;">
					<button type="button" class="btn-primary-pill" data-open-auth="signin" style="justify-content:center;">
						<span data-i18n="dashboard.signInBtn">Sign In to Dashboard</span>
						<i>↗</i>
					</button>
					<a href="/" class="dash-link" style="justify-content:center;" data-i18n="dashboard.returnHome">Return to Homepage</a>
				</div>
			</div>
		</section>

		<!-- Authenticated Main Dashboard -->
		<main class="dash-main" id="dash-authenticated" hidden>
			<!-- Hero Profile Header Banner -->
			<section class="dash-hero-card">
				<div class="dash-profile-row">
					<div class="dash-profile-meta-wrap">
						<div class="dash-avatar-large">
							<img src="" alt="" id="user-avatar-large" />
							<span class="dash-status-dot"></span>
						</div>
						<div class="dash-profile-info">
							<div class="dash-profile-heading">
								<h1 id="user-display-title">Welcome back, Traveler</h1>
								<span class="dash-tier-badge" id="user-tier-badge">Gold VIP</span>
							</div>
							<p class="dash-user-meta">
								<span id="user-email-text">user@example.com</span>
								<span class="meta-dot">·</span>
								<span id="user-since-text">Member since March 2024</span>
							</p>
						</div>
					</div>

					<div class="dash-membership-card">
						<div class="member-perk-header">
							<span class="perk-star">✦</span>
							<strong data-i18n="dashboard.activeMemberPrivilege">Active Member Privilege</strong>
						</div>
						<p class="member-perk-desc" id="user-perk-summary">15% VIP Club Rate Applied Automatically</p>
						<small class="member-perk-note" data-i18n="dashboard.privilegeNote">Valid across all guesthouses, rides &amp; guide bookings</small>
					</div>
				</div>

				<!-- Stats Summary Grid -->
				<div class="dash-stats-grid">
					<div class="stat-box">
						<span class="stat-icon">📅</span>
						<div>
							<strong class="stat-value" id="stat-bookings">0</strong>
							<span class="stat-label" data-i18n="dashboard.statBookings">Active Bookings</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon">♥</span>
						<div>
							<strong class="stat-value" id="stat-saved">0</strong>
							<span class="stat-label" data-i18n="dashboard.statSaved">Saved Stays</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon">💰</span>
						<div>
							<strong class="stat-value" id="stat-saved-money">$120+</strong>
							<span class="stat-label" data-i18n="dashboard.statSavings">Member Savings</span>
						</div>
					</div>
					<div class="stat-box">
						<span class="stat-icon">🧭</span>
						<div>
							<strong class="stat-value" id="stat-guides">1</strong>
							<span class="stat-label" data-i18n="dashboard.statGuides">Guides Hired</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Segmented Pill Tabs Bar -->
			<div class="dash-tabs-bar">
				<nav class="dash-tabs-pill" aria-label="Dashboard sections">
					<button type="button" class="dash-tab-btn is-active" data-tab-target="tab-bookings">
						<span>📅</span>
						<span data-i18n="dashboard.tabReservations">My Reservations</span>
						<span class="tab-badge" id="tab-badge-bookings">0</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-saved">
						<span>♥</span>
						<span data-i18n="dashboard.tabSaved">Saved Stays</span>
						<span class="tab-badge" id="tab-badge-saved">0</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-services">
						<span>↗</span>
						<span data-i18n="dashboard.tabServices">Guides &amp; Rides</span>
					</button>
					<button type="button" class="dash-tab-btn" data-tab-target="tab-settings">
						<span>⚙</span>
						<span data-i18n="dashboard.tabSettings">Settings</span>
					</button>
				</nav>
			</div>

			<!-- TAB 1: My Reservations -->
			<section class="dash-panel-content" id="tab-bookings">
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.reservationsHeading">My Reservations</h2>
						<p data-i18n="dashboard.reservationsSub">Confirmed guesthouse stays, check-in instructions, and itinerary codes.</p>
					</div>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" style="height:36px; font-size:12px; padding:0 16px;">
						<span data-i18n="dashboard.bookStay">+ Book Stay</span>
					</a>
				</div>

				<div class="bookings-list" id="bookings-container">
					<!-- Dynamically rendered via client script -->
				</div>

				<div class="dash-empty-card" id="bookings-empty" hidden>
					<span class="dash-empty-icon">🛌</span>
					<h3 data-i18n="dashboard.noReservationsTitle">No reservations found yet</h3>
					<p data-i18n="dashboard.noReservationsDesc">Explore verified guesthouses in Dhaka with member discounts applied automatically.</p>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" data-i18n="dashboard.browseStays">Browse Dhaka Guesthouses ↗</a>
				</div>
			</section>

			<!-- TAB 2: Saved Stays (Wishlist) -->
			<section class="dash-panel-content" id="tab-saved" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.savedHeading">Saved Guesthouses</h2>
						<p data-i18n="dashboard.savedSub">Stays you've bookmarked for upcoming trips. Ready for quick booking.</p>
					</div>
				</div>

				<div class="saved-grid" id="saved-container">
					<!-- Dynamically rendered via client script -->
				</div>

				<div class="dash-empty-card" id="saved-empty" hidden>
					<span class="dash-empty-icon">♡</span>
					<h3 data-i18n="dashboard.noSavedTitle">Your wishlist is currently empty</h3>
					<p data-i18n="dashboard.noSavedDesc">Click the heart icon on any guesthouse card while exploring to save it to your dashboard.</p>
					<a href="/guestHouses/dhaka/" class="btn-primary-pill" data-i18n="dashboard.exploreStays">Explore Stays to Save ↗</a>
				</div>
			</section>

			<!-- TAB 3: Guides & Rides -->
			<section class="dash-panel-content" id="tab-services" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.servicesHeading">Guides &amp; Transport Services</h2>
						<p data-i18n="dashboard.servicesSub">Local guides booked and airport pick &amp; drop travel arrangements.</p>
					</div>
				</div>

				<div class="bookings-list">
					<article class="booking-card">
						<div class="booking-image-wrap">
							<img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=500&auto=format&fit=crop&q=80" alt="Farzana Ahmed" />
							<span class="booking-status-tag confirmed">CONFIRMED</span>
						</div>
						<div class="booking-content-wrap">
							<div class="booking-header-row">
								<div>
									<span class="booking-eyebrow">Local Tour Guide · Old Dhaka</span>
									<h3 class="booking-stay-title">Farzana Ahmed · Old Dhaka Heritage Walk</h3>
								</div>
								<div class="booking-code-pill">
									<small data-i18n="dashboard.bookingRef">Booking Ref</small>
									<strong>GD-DH2024</strong>
								</div>
							</div>
							<div class="booking-specs-strip" style="grid-template-columns: repeat(3, 1fr);">
								<div class="spec-item">
									<span class="spec-label">Tour Date</span>
									<span class="spec-value">October 22, 2026</span>
								</div>
								<div class="spec-item">
									<span class="spec-label">Time &amp; Type</span>
									<span class="spec-value">10:00 AM · Full Day</span>
								</div>
								<div class="spec-item">
									<span class="spec-label">Rate (VIP Perk)</span>
									<span class="spec-value is-price">$28 USD</span>
								</div>
							</div>
							<div class="booking-actions-row">
								<button type="button" class="btn-view-stay" onclick="alert('Guide contact: +880 1711 002233\nMeeting Point: Ahsan Manzil Main Gate')">Contact Guide ↗</button>
							</div>
						</div>
					</article>
				</div>
			</section>

			<!-- TAB 4: Account Settings -->
			<section class="dash-panel-content" id="tab-settings" hidden>
				<div class="section-header-row">
					<div>
						<h2 data-i18n="dashboard.settingsTitle">Account Profile &amp; Preferences</h2>
						<p data-i18n="dashboard.settingsSubtitle">Manage your traveler identity, contact details, language preferences, and membership privileges.</p>
					</div>
				</div>

				<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
					<div class="dash-hero-card" style="margin-bottom:0;">
						<h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;" data-i18n="dashboard.settingsTitle">Traveler Profile</h3>
						<div style="display:grid; gap: 12px;">
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.fullName">Display Name</label>
								<input type="text" id="edit-name" value="" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit;" />
							</div>
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.emailAddress">Email Address</label>
								<input type="email" id="edit-email" value="" readonly style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-muted); font:inherit;" />
							</div>
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.contactPhone">Contact Phone</label>
								<input type="tel" id="edit-phone" value="+880 1712 345678" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit;" />
							</div>
							<div>
								<label style="font-size: 11px; font-weight: 600; text-transform:uppercase; color: var(--dash-muted);" data-i18n="dashboard.languagePref">Language &amp; Regional Display</label>
								<select id="settings-lang-select" style="width:100%; height:40px; padding:0 12px; margin-top:4px; border:1px solid var(--dash-border); border-radius:8px; background:var(--dash-surface-soft); color:var(--dash-ink); font:inherit; font-weight:600; cursor:pointer;">
								</select>
								<small style="display:block; margin-top:4px; font-size:11px; color:var(--dash-muted);" data-i18n="dashboard.languageDesc">Select your interface language for the dashboard, currency format, and stay details.</small>
							</div>
						</div>
					</div>

					<div class="dash-hero-card" style="margin-bottom:0;">
						<h3 style="font-size: 16px; font-weight: 700; margin-bottom: 6px;" data-i18n="dashboard.testTiersTitle">Test Membership Tiers</h3>
						<p style="font-size: 13px; color: var(--dash-muted); margin-bottom: 16px;" data-i18n="dashboard.testTiersDesc">Switch your active role to test dynamic rates across the website:</p>
						<div style="display:grid; gap: 10px;">
							<button type="button" class="dash-link" data-switch-role="vip" style="padding:12px; border:1px solid var(--dash-border); border-radius:10px; text-align:left; justify-content:space-between; background:var(--dash-surface-soft);">
								<div>
									<strong style="display:block; color:var(--dash-ink);" data-i18n="dashboard.goldVipTitle">⭐ Gold VIP Member (15% Off)</strong>
									<small style="color:var(--dash-muted);" data-i18n="dashboard.goldVipSubtitle">Sarah Khan's luxury traveler account</small>
								</div>
								<span style="font-size:16px;">→</span>
							</button>
							<button type="button" class="dash-link" data-switch-role="traveler" style="padding:12px; border:1px solid var(--dash-border); border-radius:10px; text-align:left; justify-content:space-between; background:var(--dash-surface-soft);">
								<div>
									<strong style="display:block; color:var(--dash-ink);" data-i18n="dashboard.silverMemberTitle">🚀 Silver Member (10% Off)</strong>
									<small style="color:var(--dash-muted);" data-i18n="dashboard.silverMemberSubtitle">Standard registered traveler tier</small>
								</div>
								<span style="font-size:16px;">→</span>
							</button>
							<button type="button" class="dash-link" data-switch-role="host" style="padding:12px; border:1px solid var(--dash-border); border-radius:10px; text-align:left; justify-content:space-between; background:var(--dash-surface-soft);">
								<div>
									<strong style="display:block; color:var(--dash-ink);" data-i18n="dashboard.diamondHostTitle">💎 Diamond Host (20% Off)</strong>
									<small style="color:var(--dash-muted);" data-i18n="dashboard.diamondHostSubtitle">Host privileges and stay discounts</small>
								</div>
								<span style="font-size:16px;">→</span>
							</button>
						</div>
					</div>
				</div>
			</section>
		</main>

		<!-- MODAL 1: View Exact Location & Directions -->
		<div class="dash-modal-backdrop" id="modal-location" role="dialog" aria-modal="true" aria-labelledby="modal-loc-title">
			<div class="dash-modal-sheet">
				<div class="modal-header-row">
					<div class="modal-header-content">
						<small id="modal-loc-eyebrow">DHAKA · GULSHAN 2</small>
						<h3 id="modal-loc-title" data-i18n="locModal.title">Property Location &amp; Directions</h3>
					</div>
					<button type="button" class="modal-close-btn" data-close-modal="modal-location" aria-label="Close modal">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
				</div>
				<div class="modal-body-content">
					<div class="modal-detail-card">
						<span class="detail-label" data-i18n="locModal.streetAddress">Exact Street Address</span>
						<div class="detail-value" id="modal-loc-address">House 24, Road 113, Gulshan-2, Dhaka 1212, Bangladesh</div>
						<div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
							<button type="button" class="btn-copy-address" id="btn-copy-address">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
								<span id="copy-btn-text" data-i18n="locModal.copyAddress">Copy Full Address</span>
							</button>
							<a href="#" target="_blank" rel="noopener noreferrer" class="btn-copy-address" id="link-google-maps">
								<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
								<span data-i18n="locModal.openMaps">Open in Google Maps ↗</span>
							</a>
						</div>
					</div>

					<div class="modal-detail-card">
						<span class="detail-label" data-i18n="locModal.checkInGate">Access &amp; Check-In Gate Info</span>
						<div class="detail-value" style="font-size:13px; font-weight:normal; line-height:1.5;">
							Guarded security entrance on Road 113. Present your booking confirmation code <strong id="modal-loc-code" style="color:var(--dash-brand); font-family:monospace;">GBD-DH8492</strong> to the concierge staff for immediate access card and room key handover.
						</div>
					</div>
				</div>
				<div class="modal-footer-row">
					<button type="button" class="btn-modal-ghost" data-close-modal="modal-location" data-i18n="locModal.close">Close</button>
					<a href="#" target="_blank" rel="noopener noreferrer" class="btn-modal-primary" id="btn-modal-directions">
						<span data-i18n="locModal.openNavigation">Open Map Navigation</span>
						<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
					</a>
				</div>
			</div>
		</div>

		<!-- MODAL 2: Call Host -->
		<div class="dash-modal-backdrop" id="modal-host" role="dialog" aria-modal="true" aria-labelledby="modal-host-title">
			<div class="dash-modal-sheet">
				<div class="modal-header-row">
					<div class="modal-header-content">
						<small id="modal-host-stay">City Lights Guest House</small>
						<h3 id="modal-host-title" data-i18n="hostModal.title">Direct Host Contact</h3>
					</div>
					<button type="button" class="modal-close-btn" data-close-modal="modal-host" aria-label="Close modal">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
					</button>
				</div>
				<div class="modal-body-content">
					<div class="modal-person-row">
						<img id="modal-host-avatar" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=200&auto=format&fit=crop&q=80" alt="Host avatar" class="modal-person-avatar" />
						<div class="modal-person-info">
							<span class="modal-person-name" id="modal-host-name">Farhana Yasmin</span>
							<span class="modal-person-tag">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
								<span data-i18n="hostModal.superhost">Verified Superhost · Under 15m response</span>
							</span>
						</div>
					</div>

					<div class="modal-action-buttons">
						<a href="tel:+8801711234567" id="modal-host-tel-btn" class="btn-contact-call">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							<span data-i18n="hostModal.callHost">Direct Call</span>
						</a>
						<a href="https://wa.me/8801711234567" id="modal-host-wa-btn" target="_blank" rel="noopener noreferrer" class="btn-contact-whatsapp">
