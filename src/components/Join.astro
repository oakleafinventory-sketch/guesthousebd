---
import homeContent from '../data/home.json';
---

<section class="panel" id="join">
	<div class="join">
		<div>
			<h2 data-i18n="join.title">Create your account</h2><p style="color: var(--mut); margin-top: 8px" data-i18n="join.description">Join with the app you already use.</p>
			<div class="sso" id="sso"></div>
			<form class="field" onsubmit="return false"><input type="email" placeholder="Or use your email" aria-label="Email" data-i18n-placeholder="join.email" data-i18n-aria-label="join.emailLabel" /><button data-i18n="join.continue">Continue</button></form>
		</div>
		<img src={homeContent.media.accountJoinImage} alt="" />
	</div>
</section>