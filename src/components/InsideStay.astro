---
import homeContent from '../data/home.json';
---

<section class="panel step">
	<video id="stay-video" class="step-background-video ambient-video" muted loop playsinline preload="metadata" poster={homeContent.media.insideStay.videoPoster} aria-hidden="true" tabindex="-1">
		<source src={homeContent.media.insideStay.video} type="video/mp4" />
	</video>
	<div class="t"><small data-i18n="inside.step">STEP</small><h2 style="color: #fff" data-i18n="inside.title">Inside for living</h2><br /><a class="btn" href="#stays"><span data-i18n="inside.view">View stays</span> <i>↗</i></a></div>
	<div class="frame"><img id="fr" src={homeContent.media.insideStay.frameImage} alt="" /></div>
</section>