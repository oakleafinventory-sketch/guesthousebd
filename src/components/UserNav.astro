---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['user-nav-container', compact && 'is-compact']} data-user-nav>
	<!-- Logged Out State -->
	<div class="user-nav-logged-out" data-nav-logged-out>
		<button type="button" class="auth-trigger-btn" data-open-auth="signin" aria-label="Sign in to your account">
			<span class="auth-trigger-icon" aria-hidden="true">👤</span>
			<span class="auth-trigger-text" data-i18n="nav.signIn">Sign In</span>
		</button>
	</div>

	<!-- Logged In State -->
	<div class="user-nav-logged-in" data-nav-logged-in hidden>
		<button type="button" class="user-profile-btn" data-user-menu-trigger aria-expanded="false" aria-haspopup="true">
			<div class="avatar-wrap">
				<img src="" alt="" data-user-avatar class="user-avatar-img" />
				<span class="status-indicator"></span>
			</div>
			<div class="user-info-brief">
				<span class="user-display-name" data-user-name>User</span>
				<span class="user-tier-pill" data-user-tier>VIP</span>
			</div>
			<span class="menu-chevron" aria-hidden="true">▾</span>
		</button>

		<!-- Dropdown Menu -->
		<div class="user-dropdown-menu" data-user-dropdown-menu hidden>
			<div class="dropdown-header">
				<div class="dropdown-user-details">
					<strong class="dropdown-user-name" data-dropdown-name>User</strong>
					<span class="dropdown-user-email" data-dropdown-email>user@example.com</span>
				</div>
				<div class="dropdown-tier-card">
					<span class="tier-icon">✦</span>
					<div>
						<strong class="tier-name" data-dropdown-tier>Gold VIP</strong>
						<small class="tier-perk" data-dropdown-perk data-i18n="nav.vipClub">15% VIP Club Rate Active</small>
					</div>
				</div>
			</div>

			<div class="dropdown-links">
				<a href="/dashboard/" class="dropdown-link">
					<span class="link-icon">📊</span>
					<div class="link-body">
						<strong data-i18n="nav.myDashboard">My Dashboard</strong>
						<small data-i18n="nav.overview">Overview &amp; account control</small>
					</div>
				</a>
				<a href="/dashboard/#bookings" class="dropdown-link">
					<span class="link-icon">📅</span>
					<div class="link-body">
						<strong data-i18n="nav.reservations">Reservations</strong>
						<small data-i18n="nav.activeStays">Active &amp; past stays</small>
					</div>
				</a>
				<a href="/dashboard/#saved" class="dropdown-link">
					<span class="link-icon">♥</span>
					<div class="link-body">
						<strong data-i18n="nav.savedStays">Saved Stays</strong>
						<small data-i18n="nav.wishlistSub">Your wishlisted guesthouses</small>
					</div>
					<span class="saved-count-pill" data-saved-count>0</span>
				</a>
			</div>

			<div class="dropdown-footer">
				<button type="button" class="dropdown-logout-btn" data-action-logout>
					<span aria-hidden="true">🚪</span>
					<span data-i18n="nav.signOut">Sign Out</span>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import i18next from 'i18next';
	import { languages, resources } from '../i18n/locales.js';
	import { authManager, type UserProfile } from '../scripts/auth';

	function initUserNav(container: HTMLElement) {
		const loggedOut = container.querySelector<HTMLElement>('[data-nav-logged-out]');
		const loggedIn = container.querySelector<HTMLElement>('[data-nav-logged-in]');
		const triggerBtn = container.querySelector<HTMLButtonElement>('[data-user-menu-trigger]');
		const dropdown = container.querySelector<HTMLElement>('[data-user-dropdown-menu]');
		const avatarImg = container.querySelector<HTMLImageElement>('[data-user-avatar]');
		const nameLabel = container.querySelector<HTMLElement>('[data-user-name]');
		const tierPill = container.querySelector<HTMLElement>('[data-user-tier]');
		const dropName = container.querySelector<HTMLElement>('[data-dropdown-name]');
		const dropEmail = container.querySelector<HTMLElement>('[data-dropdown-email]');
		const dropTier = container.querySelector<HTMLElement>('[data-dropdown-tier]');
		const dropPerk = container.querySelector<HTMLElement>('[data-dropdown-perk]');
		const logoutBtn = container.querySelector<HTMLButtonElement>('[data-action-logout]');
		const savedCountBadge = container.querySelector<HTMLElement>('[data-saved-count]');

		// i18n initialization
		const getSavedLang = () => {
			try {
				return localStorage.getItem('guesthouse-language') || 'en';
			} catch {
				return 'en';
			}
		};

		const navI18n = i18next.createInstance();
		navI18n.init({
			lng: getSavedLang(),
			fallbackLng: 'en',
			resources,
			interpolation: { escapeValue: false },
			initImmediate: false
		});

		function applyNavTranslations() {
			container.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
				const key = el.dataset.i18n;
				if (key) {
					el.textContent = navI18n.t(key);
				}
			});
		}
		applyNavTranslations();

		window.addEventListener('guesthouse:language-changed', (e: any) => {
			const lang = e?.detail?.language || getSavedLang();
			navI18n.changeLanguage(lang);
			applyNavTranslations();
		});

		window.addEventListener('storage', (e) => {
			if (e.key === 'guesthouse-language' && e.newValue) {
				navI18n.changeLanguage(e.newValue);
				applyNavTranslations();
			}
		});

		function updateWishlistBadge() {
			if (!savedCountBadge) return;
			const count = authManager.getSavedStays().length;
			savedCountBadge.textContent = String(count);
			savedCountBadge.hidden = count === 0;
		}

		function render(user: UserProfile | null) {
			if (user) {
				if (loggedOut) loggedOut.hidden = true;
				if (loggedIn) loggedIn.hidden = false;

				if (avatarImg) {
					avatarImg.src = user.avatar;
					avatarImg.alt = user.name;
				}
				if (nameLabel) nameLabel.textContent = user.name.split(' ')[0];
				if (tierPill) {
					tierPill.textContent = user.tier.replace(' Member', '').replace(' Host', '');
					tierPill.className = `user-tier-pill is-${user.role}`;
				}
				if (dropName) dropName.textContent = user.name;
				if (dropEmail) dropEmail.textContent = user.email;
				if (dropTier) dropTier.textContent = user.tier;
				if (dropPerk) {
					const pct = Math.round(user.discountRate * 100);
					dropPerk.textContent = `${pct}% ${navI18n.t('nav.vipClub')}`;
				}
			} else {
				if (loggedOut) loggedOut.hidden = false;
				if (loggedIn) loggedIn.hidden = true;
				if (dropdown) dropdown.hidden = true;
				if (triggerBtn) triggerBtn.setAttribute('aria-expanded', 'false');
			}
			updateWishlistBadge();
			applyNavTranslations();
		}

		authManager.subscribe(render);
		window.addEventListener('guesthouse:saved-changed', updateWishlistBadge);

		triggerBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			if (!dropdown) return;
			const isVisible = !dropdown.hidden;
			dropdown.hidden = isVisible;
			triggerBtn.setAttribute('aria-expanded', String(!isVisible));
		});

		logoutBtn?.addEventListener('click', async () => {
			if (dropdown) dropdown.hidden = true;
			await authManager.signOut();
			// If on dashboard, navigate to home
			if (window.location.pathname.includes('/dashboard')) {
				window.location.href = '/';
			}
		});

		document.addEventListener('click', (event) => {
			if (!dropdown || dropdown.hidden) return;
			if (!container.contains(event.target as Node)) {
				dropdown.hidden = true;
				triggerBtn?.setAttribute('aria-expanded', 'false');
			}
		});
	}

	document.querySelectorAll<HTMLElement>('[data-user-nav]').forEach(initUserNav);
</script>

<style>
	.user-nav-container {
		position: relative;
		display: inline-flex;
		align-items: center;
	}
	.auth-trigger-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 16px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-soft);
		color: var(--header-ink);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
	}
	.auth-trigger-btn:hover {
		background: var(--surface);
		border-color: var(--brand);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(230, 24, 61, 0.12);
	}
	.auth-trigger-icon {
		font-size: 14px;
	}
	.user-profile-btn {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		height: 42px;
		padding: 3px 12px 3px 5px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--header-ink);
		cursor: pointer;
		transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
	}
	.user-profile-btn:hover {
		border-color: var(--brand);
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
		transform: translateY(-1px);
	}
	.avatar-wrap {
		position: relative;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		overflow: hidden;
		flex-shrink: 0;
		border: 1.5px solid var(--brand);
	}
	.user-avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.status-indicator {
		position: absolute;
		right: 1px;
		bottom: 1px;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
		border: 1.5px solid #fff;
	}
	.user-info-brief {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.user-display-name {
		font-size: 13px;
		font-weight: 600;
		color: var(--header-ink);
		max-width: 90px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.user-tier-pill {
		font-size: 10px;
		font-weight: 700;
		padding: 2px 6px;
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 0.3px;
	}
	.user-tier-pill.is-vip {
		background: #fdf3d8;
		color: #9a6700;
	}
	.user-tier-pill.is-traveler {
		background: #edf0f5;
		color: #435269;
	}
	.user-tier-pill.is-host {
		background: #fce7f3;
		color: #9d174d;
	}
	.menu-chevron {
		font-size: 11px;
		color: var(--mut);
	}
	.user-dropdown-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		z-index: 50;
		width: 270px;
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--surface);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
		overflow: hidden;
		animation: menuPop 0.18s ease-out;
	}
	@keyframes menuPop {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}
	.dropdown-header {
		padding: 14px 16px;
		border-bottom: 1px solid var(--border);
		background: var(--surface-soft);
	}
	.dropdown-user-details {
		margin-bottom: 8px;
	}
	.dropdown-user-name {
		display: block;
		font-size: 14px;
		color: var(--ink);
	}
	.dropdown-user-email {
		display: block;
		font-size: 11px;
		color: var(--mut);
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.dropdown-tier-card {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 8px;
		border-radius: 8px;
		background: var(--surface);
		border: 1px solid var(--border);
	}
	.tier-icon {
		color: var(--brand);
		font-size: 14px;
	}
	.tier-name {
		display: block;
		font-size: 11px;
		font-weight: 700;
	}
	.tier-perk {
		display: block;
		font-size: 10px;
		color: #059669;
		font-weight: 600;
	}
	.dropdown-links {
		padding: 6px 0;
	}
	.dropdown-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 16px;
		color: var(--ink);
		text-decoration: none;
		transition: background 0.15s;
	}
	.dropdown-link:hover {
		background: var(--surface-soft);
	}
	.link-icon {
		font-size: 16px;
	}
	.link-body {
		flex: 1;
	}
	.link-body strong {
		display: block;
		font-size: 13px;
		line-height: 1.2;
	}
	.link-body small {
		display: block;
		font-size: 10px;
		color: var(--mut);
	}
	.saved-count-pill {
		font-size: 11px;
		font-weight: 700;
		padding: 2px 7px;
		border-radius: 999px;
		background: var(--brand);
		color: #fff;
	}
	.dropdown-footer {
		padding: 8px;
		border-top: 1px solid var(--border);
	}
	.dropdown-logout-btn {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		padding: 8px 12px;
		border: 0;
		border-radius: 8px;
		background: none;
		color: #dc2626;
		font-size: 12px;
		font-weight: 600;
		cursor: pointer;
		text-align: left;
		transition: background 0.15s;
	}
	.dropdown-logout-btn:hover {
		background: #fee2e2;
	}
	:root[data-theme='dark'] .dropdown-logout-btn:hover {
		background: #451010;
	}
	:root[data-theme='dark'] .tier-perk {
		color: #34d399;
	}
	:root[data-theme='dark'] .user-tier-pill.is-vip {
		background: #3c2f0d;
		color: #f7d070;
	}
	:root[data-theme='dark'] .user-tier-pill.is-traveler {
		background: #232b36;
		color: #b5c7dd;
	}
	:root[data-theme='dark'] .user-tier-pill.is-host {
		background: #4a152e;
		color: #f9a8d4;
	}
	@media (max-width: 600px) {
		.user-info-brief {
			display: none;
		}
		.user-profile-btn {
			padding: 3px 6px 3px 4px;
		}
	}
</style>
