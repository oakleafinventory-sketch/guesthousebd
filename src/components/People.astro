<section class="panel" id="people">
	<div class="top">
		<h2 data-i18n="people.assistants">Tour assistants</h2>
		<div class="people-controls">
			<div class="tog" data-t="a"></div>
			<button class="mobile-filter-button" type="button" data-open-people-filter="a" aria-haspopup="dialog" aria-controls="people-filter-dialog" aria-label="Open tour assistant filters">
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M7 12h10m-7 5h4"/><circle cx="8" cy="7" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="12" cy="17" r="1.5"/></svg>
			</button>
		</div>
	</div>
	<div class="people-layout">
		<div class="grid" id="ga"></div>
		<aside class="filter-panel" data-filter-kind="a" aria-label="Filter tour assistants">
			<h3>Add filter</h3>
			<div class="filter-list">
				<div class="filter-item">
					<label for="price-a">Price range</label>
					<div class="filter-value" id="price-value-a">Up to $90 / day</div>
					<input id="price-a" type="range" min="30" max="120" step="5" value="90" />
				</div>
				<div class="filter-item">
					<label for="age-a">Age range</label>
					<div class="filter-value" id="age-value-a">Up to 50</div>
					<input id="age-a" type="range" min="18" max="60" step="1" value="50" />
				</div>
				<div class="filter-item">
					<label for="rating-a">Rating</label>
					<div class="filter-value" id="rating-value-a">4.5+</div>
					<input id="rating-a" type="range" min="3.5" max="5" step="0.5" value="4.5" />
				</div>
			</div>
		</aside>
	</div>
	<div class="top" style="margin-top: 64px">
		<h2 data-i18n="people.guides">Travel guides</h2>
		<div class="people-controls">
			<div class="tog" data-t="g"></div>
			<button class="mobile-filter-button" type="button" data-open-people-filter="g" aria-haspopup="dialog" aria-controls="people-filter-dialog" aria-label="Open travel guide filters">
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M7 12h10m-7 5h4"/><circle cx="8" cy="7" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="12" cy="17" r="1.5"/></svg>
			</button>
		</div>
	</div>
	<div class="people-layout">
		<div class="grid" id="gg"></div>
		<aside class="filter-panel" data-filter-kind="g" aria-label="Filter travel guides">
			<h3>Add filter</h3>
			<div class="filter-list">
				<div class="filter-item">
					<label for="price-g">Price range</label>
					<div class="filter-value" id="price-value-g">Up to $90 / day</div>
					<input id="price-g" type="range" min="30" max="120" step="5" value="90" />
				</div>
				<div class="filter-item">
					<label for="age-g">Age range</label>
					<div class="filter-value" id="age-value-g">Up to 50</div>
					<input id="age-g" type="range" min="18" max="60" step="1" value="50" />
				</div>
				<div class="filter-item">
					<label for="rating-g">Rating</label>
					<div class="filter-value" id="rating-value-g">4.5+</div>
					<input id="rating-g" type="range" min="3.5" max="5" step="0.5" value="4.5" />
				</div>
			</div>
		</aside>
	</div>
	<dialog class="people-filter-dialog" id="people-filter-dialog" aria-labelledby="people-filter-title">
		<div class="people-filter-heading">
			<h3 id="people-filter-title" data-people-filter-title>Filters</h3>
			<button class="people-filter-close" type="button" data-close-people-filter aria-label="Close filters">×</button>
		</div>
		<div class="filter-list">
			<div class="filter-item">
				<label for="mobile-price-filter">Price range</label>
				<div class="filter-value" data-mobile-filter-value="price"></div>
				<input id="mobile-price-filter" type="range" min="30" max="120" step="5" value="90" data-mobile-filter="price" />
			</div>
			<div class="filter-item">
				<label for="mobile-age-filter">Age range</label>
				<div class="filter-value" data-mobile-filter-value="age"></div>
				<input id="mobile-age-filter" type="range" min="18" max="60" step="1" value="50" data-mobile-filter="age" />
			</div>
			<div class="filter-item">
				<label for="mobile-rating-filter">Rating</label>
				<div class="filter-value" data-mobile-filter-value="rating"></div>
				<input id="mobile-rating-filter" type="range" min="3.5" max="5" step="0.5" value="4.5" data-mobile-filter="rating" />
			</div>
		</div>
		<div class="people-filter-actions">
			<button type="button" data-reset-people-filter>Reset</button>
			<button type="button" data-apply-people-filter>Show results</button>
		</div>
	</dialog>
</section>