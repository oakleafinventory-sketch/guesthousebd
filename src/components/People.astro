<section class="panel" id="people">
	<div class="top">
		<h2 data-i18n="people.assistants">Tour assistants</h2>
		<div class="tog" data-t="a"></div>
	</div>
	<div class="people-layout">
		<div class="grid" id="ga"></div>
		<aside class="filter-panel" data-filter-kind="a" aria-label="Filter tour assistants">
			<h3>Add filter</h3>
			<div class="filter-list">
				<div class="filter-item">
					<label for="price-a">Price range</label>
					<div class="filter-value" id="price-value-a">Up to $90 / day</div>
					<input id="price-a" type="range" min="30" max="120" step="5" value="90" />
				</div>
				<div class="filter-item">
					<label for="age-a">Age range</label>
					<div class="filter-value" id="age-value-a">Up to 50</div>
					<input id="age-a" type="range" min="18" max="60" step="1" value="50" />
				</div>
				<div class="filter-item">
					<label for="rating-a">Rating</label>
					<div class="filter-value" id="rating-value-a">4.5+</div>
					<input id="rating-a" type="range" min="3.5" max="5" step="0.5" value="4.5" />
				</div>
			</div>
		</aside>
	</div>
	<div class="top" style="margin-top: 64px">
		<h2 data-i18n="people.guides">Travel guides</h2>
		<div class="tog" data-t="g"></div>
	</div>
	<div class="people-layout">
		<div class="grid" id="gg"></div>
		<aside class="filter-panel" data-filter-kind="g" aria-label="Filter travel guides">
			<h3>Add filter</h3>
			<div class="filter-list">
				<div class="filter-item">
					<label for="price-g">Price range</label>
					<div class="filter-value" id="price-value-g">Up to $90 / day</div>
					<input id="price-g" type="range" min="30" max="120" step="5" value="90" />
				</div>
				<div class="filter-item">
					<label for="age-g">Age range</label>
					<div class="filter-value" id="age-value-g">Up to 50</div>
					<input id="age-g" type="range" min="18" max="60" step="1" value="50" />
				</div>
				<div class="filter-item">
					<label for="rating-g">Rating</label>
					<div class="filter-value" id="rating-value-g">4.5+</div>
					<input id="rating-g" type="range" min="3.5" max="5" step="0.5" value="4.5" />
				</div>
			</div>
		</aside>
	</div>
</section>